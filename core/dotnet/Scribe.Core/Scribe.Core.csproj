<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Brasscribe.Core</RootNamespace>
    <Description>P/Invoke wrapper of the brasscribe Rust core (brasscribe_ffi C ABI).</Description>
    <Copyright>Copyright (c) 2026 Kristoffer-Andre Kalliainen</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- The native library: brasscribe_ffi.dll (Windows), libbrasscribe_ffi.dylib (macOS), libbrasscribe_ffi.so (Linux).
       core/scripts/build-all.sh builds the macOS and Windows ones into core/dist/<platform>/; the Linux one is the host
       build in core/target/release (a cargo release build of brasscribe-ffi, or scripts/core-artifacts.sh ensure host).
       No script builds win-arm64 yet. -->
  <ItemGroup>
    <None Include="../../target/release/libbrasscribe_ffi.so" Condition="Exists('../../target/release/libbrasscribe_ffi.so')"
          Link="libbrasscribe_ffi.so" CopyToOutputDirectory="PreserveNewest" Pack="true"
          PackagePath="runtimes/linux-x64/native" />
    <None Include="../../dist/macos/libbrasscribe_ffi.dylib" Condition="Exists('../../dist/macos/libbrasscribe_ffi.dylib')"
          Link="libbrasscribe_ffi.dylib" CopyToOutputDirectory="PreserveNewest" Pack="true"
          PackagePath="runtimes/osx-arm64/native" />
    <None Include="../../dist/windows/brasscribe_ffi.dll" Condition="Exists('../../dist/windows/brasscribe_ffi.dll')"
          Link="brasscribe_ffi.dll" CopyToOutputDirectory="PreserveNewest" Pack="true"
          PackagePath="runtimes/win-x64/native" />
  </ItemGroup>

</Project>

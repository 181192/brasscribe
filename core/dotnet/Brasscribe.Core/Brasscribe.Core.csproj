<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Brasscribe.Core</RootNamespace>
    <Description>P/Invoke wrapper of the brasscribe Rust core (brasscribe_ffi C ABI).</Description>
    <Copyright>Copyright (c) 2026 Kristoffer-Andre Kalliainen</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- The native library: brasscribe_ffi.dll (Windows), libbrasscribe_ffi.dylib (macOS), libbrasscribe_ffi.so (Linux).
       core/scripts/build-all.sh builds them into core/dist/<platform>/. -->
  <ItemGroup>
    <None Include="../../dist/macos/libbrasscribe_ffi.dylib" Condition="Exists('../../dist/macos/libbrasscribe_ffi.dylib')"
          Link="libbrasscribe_ffi.dylib" CopyToOutputDirectory="PreserveNewest" Pack="true"
          PackagePath="runtimes/osx-arm64/native" />
    <None Include="../../dist/windows/brasscribe_ffi.dll" Condition="Exists('../../dist/windows/brasscribe_ffi.dll')"
          Link="brasscribe_ffi.dll" CopyToOutputDirectory="PreserveNewest" Pack="true"
          PackagePath="runtimes/win-x64/native" />
  </ItemGroup>

</Project>

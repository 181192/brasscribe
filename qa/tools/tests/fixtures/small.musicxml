<?xml version="1.0" encoding="UTF-8"?>
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1"><part-name>Solo Cornet</part-name><part-abbreviation>Cnt.</part-abbreviation></score-part>
    <score-part id="P2"><part-name>Repiano Cornet</part-name><part-abbreviation>Cnt.</part-abbreviation></score-part>
    <score-part id="P3"><part-name>Bass Trombone</part-name><part-abbreviation>B. Tbn.</part-abbreviation></score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes><divisions>8</divisions><key><fifths>2</fifths></key><time><beats>4</beats><beat-type>4</beat-type></time><clef><sign>G</sign><line>2</line></clef></attributes>
      <!-- 32nd note (short) and 32nd rest, 16th (tie start), 16th tie stop (stub) -->
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>1</duration><type>32nd</type></note>
      <note><rest/><duration>1</duration><type>32nd</type></note>
      <note><pitch><step>E</step><alter>1</alter><octave>5</octave></pitch><duration>2</duration><tie type="start"/><type>16th</type><accidental>sharp</accidental></note>
      <note><pitch><step>E</step><alter>1</alter><octave>5</octave></pitch><duration>2</duration><tie type="stop"/><type>16th</type></note>
      <note><rest/><duration>2</duration><type>16th</type></note>
      <!-- coloured note without a distinct notehead: colour-only uncertainty -->
      <note color="#D0021B"><pitch><step>C</step><octave>6</octave></pitch><duration>8</duration><type>quarter</type></note>
      <!-- G3: 2 ledger lines -->
      <note><pitch><step>G</step><octave>3</octave></pitch><duration>8</duration><type>quarter</type></note>
      <!-- coloured with a diamond notehead: shape-encoded, not colour-only -->
      <note color="#D0021B"><pitch><step>A</step><octave>4</octave></pitch><duration>8</duration><type>quarter</type><notehead>diamond</notehead></note>
    </measure>
    <measure number="2">
      <note><rest measure="yes"/><duration>32</duration></note>
    </measure>
    <measure number="3">
      <note><pitch><step>E</step><octave>3</octave></pitch><duration>28</duration><type>half</type><dot/><dot/></note>
      <note><rest/><duration>4</duration><type>eighth</type></note>
    </measure>
  </part>
  <part id="P2">
    <measure number="1">
      <attributes><divisions>4</divisions><clef><sign>G</sign><line>2</line></clef></attributes>
      <note><rest measure="yes"/><duration>16</duration></note>
    </measure>
    <measure number="2"><note><rest measure="yes"/><duration>16</duration></note></measure>
    <measure number="3"><note><rest measure="yes"/><duration>16</duration></note></measure>
  </part>
  <part id="P3">
    <measure number="1">
      <attributes><divisions>4</divisions><clef><sign>F</sign><line>4</line></clef></attributes>
      <!-- C2: 2 ledger lines below bass clef; chord member = divisi -->
      <note><pitch><step>C</step><octave>2</octave></pitch><duration>16</duration><type>whole</type></note>
      <note><chord/><pitch><step>G</step><octave>2</octave></pitch><duration>16</duration><type>whole</type></note>
    </measure>
    <measure number="2">
      <note><pitch><step>A</step><octave>3</octave></pitch><duration>16</duration><type>whole</type></note>
    </measure>
    <measure number="3">
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>16</duration><type>whole</type></note>
    </measure>
  </part>
</score-partwise>

          "f": 80,
          "q": 0.707
        },
        {
          "type": "peak",
          "f": 900,
          "gain_db": 1.5,
          "q": 0.9
        },
        {
          "type": "highshelf",
          "f": 4000,
          "gain_db": -1.5,
          "q": 0.7
        }
      ],
      "why": "E-flat tenor horn from F horn: close in register and colour; a small mid lift for the upright bell.",
      "range": [
        45,
        75
      ],
      "extend": [
        {
          "library": "iowa-mis",
          "instrument": "horn",
          "why": "VSCO horn is sampled every 3-5 semitones with gaps (up to 10-semitone stretch). Iowa horn (chromatic ff, partial mf/pp) fills keys more than 2 semitones from any VSCO note, spectrally matched to VSCO horn."
        }
      ]
    },

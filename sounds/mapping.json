{
  "about": "Brass-band parts mapped to the nearest sampled instrument. 'targets' are built instruments (one SFZ + one SF2 each); 'parts' assign score parts to targets per player desk. Ranges come from music/src/brasscribe_music/instruments.py (sounding pitch, MIDI). EQ stages are RBJ-cookbook biquads applied offline to the built sample copies (see sounds/dsp.py), so every player plays identical audio. 'seat' refers to sounds/seating.json. Parts are keyed by score part name (the MusicXML part-name / MIDI track name). Part 'gain_db' is the mix balance, set by comparing per-stem loudness (sounds/checks.py balance) against a contest band's usual weighting (strong basses and euphoniums). 'transposition' (sounding minus written, MusicXML chromatic/diatonic) and 'range' are copied from instruments.py for engines that read written-pitch parts.",
  "eq_reference": "RBJ Audio EQ Cookbook biquads (lowshelf/highshelf/peak with gain_db and q; lowpass/highpass with q), cascaded in list order at 44.1 kHz, applied with scipy.signal.sosfilt (causal, same as a native biquad chain).",
  "targets": {
    "soprano-cornet": {
      "instrument": "eb-soprano-cornet",
      "source": {
        "library": "vsco2ce",
        "instrument": "trumpet"
      },
      "stac_source": {
        "library": "vsco2ce",
        "instrument": "trumpet"
      },
      "eq": [
        {
          "type": "highshelf",
          "f": 4500,
          "gain_db": -2.5,
          "q": 0.7
        },
        {
          "type": "peak",
          "f": 1400,
          "gain_db": -1.5,
          "q": 1.0
        }
      ],
      "why": "E-flat soprano is a small cornet: keep trumpet brilliance, trim the upper presence a little.",
      "range": [
        57,
        87
      ]
    },
    "cornet-a": {
      "instrument": "bb-cornet",
      "source": {
        "library": "iowa-mis",
        "instrument": "trumpet"
      },
      "stac_source": {
        "library": "iowa-mis",
        "instrument": "trumpet"
      },
      "eq": [
        {
          "type": "lowshelf",
          "f": 350,
          "gain_db": 2.0,
          "q": 0.7
        },
        {
          "type": "peak",
          "f": 1600,
          "gain_db": -2.0,
          "q": 1.0
        },
        {
          "type": "peak",
          "f": 2600,
          "gain_db": -3.0,
          "q": 1.0
        },
        {
          "type": "highshelf",
          "f": 3200,
          "gain_db": -5.0,
          "q": 0.7
        },
        {
          "type": "lowpass",
          "f": 6000,
          "q": 0.707
        }
      ],
      "why": "Cornet: shorter, more conical bore than trumpet; less energy above ~3 kHz and a rounder low-mid. The Iowa trumpet is close-miked and brighter than the VSCO one, so this desk gets an extra 2.6 kHz cut and a lower top.",
      "range": [
        52,
        82
      ]
    },
    "cornet-b": {
      "instrument": "bb-cornet",
      "source": {
        "library": "vsco2ce",
        "instrument": "trumpet"
      },
      "stac_source": {
        "library": "vsco2ce",
        "instrument": "trumpet"
      },
      "eq": [
        {
          "type": "lowshelf",
          "f": 350,
          "gain_db": 2.0,
          "q": 0.7
        },
        {
          "type": "peak",
          "f": 1600,
          "gain_db": -2.0,
          "q": 1.0
        },
        {
          "type": "highshelf",
          "f": 3200,
          "gain_db": -5.0,
          "q": 0.7
        },
        {
          "type": "lowpass",
          "f": 9000,
          "q": 0.707
        }
      ],
      "why": "Same cornet adaptation from the second trumpet library, so unison desks are not sample clones.",
      "range": [
        52,
        82
      ]
    },
    "flugelhorn": {
      "instrument": "flugelhorn",
      "source": {
        "library": "iowa-mis",
        "instrument": "horn"
      },
      "stac_source": {
        "library": "iowa-mis",
        "instrument": "horn"
      },
      "eq": [
        {
          "type": "highpass",
          "f": 90,
          "q": 0.707
        },
        {
          "type": "peak",
          "f": 1100,
          "gain_db": 2.0,
          "q": 0.9
        },
        {
          "type": "highshelf",
          "f": 5000,
          "gain_db": -3.0,
          "q": 0.7
        }
      ],
      "why": "Flugel from horn: similar dark, wide-bore tone; recorded horn is heard off the back of the bell, so lift the 1 kHz region the forward-facing flugel projects.",
      "range": [
        52,
        82
      ],
      "extend": [
        {
          "library": "iowa-mis",
          "instrument": "trumpet",
          "why": "Iowa horn stops at F5 (77); the flugel range reaches B♭5 (82). Iowa trumpet notes above it are spectrally matched to the Iowa horn (the flugel's darker, conical tone) on the pitches both have, instead of F5 stretched up 5 semitones."
        }
      ]
    },
    "tenor-horn": {
      "instrument": "eb-tenor-horn",
      "source": {
        "library": "vsco2ce",
        "instrument": "horn"

    </score-part>
    <score-part id="P3"><part-name>Percussion</part-name>
      <score-instrument id="P3-I1"><instrument-name>Snare Drum</instrument-name></score-instrument>
      <midi-instrument id="P3-I1"><midi-channel>10</midi-channel><midi-unpitched>39</midi-unpitched></midi-instrument>

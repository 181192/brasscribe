        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Fretscribe. Bandroom on your computer is newer than this app, and they only work together when both are up to date."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdater Fretscribe. Bandroom på datamaskinen er nyere enn denne appen, og de virker bare sammen når begge er oppdatert."
          }
        }
      }
    },
    "Use link": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk lenken"
          }
        }
      }
    },
    "Usual tuning": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanlig stemming"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Versjon %@"
          }
        }
      }
    },
    "Waiting for your computer …": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på datamaskinen …"
          }
        }
      }
    },
    "What Fretscribe heard can't be shown right now. You can still open the tab.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det Fretscribe hørte, kan ikke vises nå. Du kan likevel åpne tabben."
          }
        }
      }
    },
    "What is on this device stays. To use the computer again, pair once more.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs already on this device stay. To use the computer again, pair once more."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangene som allerede er på denne enheten, blir værende. For å bruke datamaskinen igjen må du koble til på nytt."
          }
        }
      }
    },
    "What is this?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva er dette?"
          }
        }
      }
    },
    "What you play": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva du spiller"
          }
        }
      }
    },
    "Which app should connect to your computer?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken app skal kobles til datamaskinen?"
          }
        }
      }
    },
    "Which hand is on the neck?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken hånd er på halsen?"
          }
        }
      }
    },
    "Without the desktop program, start the engine with “scribe serve --lan”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Bandroom, start the engine with “scribe serve --lan”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten Bandroom starter du motoren med «scribe serve --lan»."
          }
        }
      }
    },
    "Write down a tab": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag en tab"
          }
        }
      }
    },
    "Writing down the notes": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver ned tonene"
          }
        }
      }
    },
    "Written as it was heard, as you chose.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet slik det ble hørt, slik du valgte."
          }
        }
      }
    },
    "Written one octave higher than it was heard.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet én oktav høyere enn det ble hørt."
          }
        }
      }
    },
    "Written one octave higher, as you chose.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet én oktav høyere, slik du valgte."
          }
        }
      }
    },
    "Written one octave lower than it was heard.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet én oktav lavere enn det ble hørt."
          }
        }
      }
    },
    "Written one octave lower, as you chose.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet én oktav lavere, slik du valgte."
          }
        }
      }
    },
    "Written two octaves lower than it was heard.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet to oktaver lavere enn det ble hørt."
          }
        }
      }
    },
    "You can change this later.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan endre dette senere."
          }
        }
      }
    },
    "You read": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du leser"
          }
        }
      }
    },
    "Your answer decides how Fretscribe listens.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret ditt bestemmer hvordan Fretscribe lytter."
          }
        }
      }
    },
    "Your computer": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Datamaskinen din"
          }
        }
      }
    },
    "Your computer doesn't have the recording any more. You can still read the tab.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Datamaskinen har ikke opptaket lenger. Du kan fortsatt lese tabben."
          }
        }
      }
    },
    "Your instrument": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumentet ditt"
          }
        }
      }
    },
    "Your recordings stay on your own devices. Free, with nothing locked.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptakene dine blir på dine egne enheter. Gratis, uten noe som er låst."
          }
        }
      }
    },
    "Your songs": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangene dine"
          }
        }
      }
    },
    "Zoom in": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom inn"
          }
        }
      }
    },
    "Zoom out": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom ut"
          }
        }
      }
    },
    "any recording.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "hvilket som helst opptak."
          }
        }
      }
    },

      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellomrom spiller av og setter opptaket på pause. Når tabben har tastaturfokus, går pil høyre en takt fram, og pil venstre en takt tilbake eller til starten av taktene som gjentas."
          }
        }

    },
    "Back to the start of the repeat": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbake til starten av gjentakelsen"
          }
        }
      }
    },
    "Bandroom on this Mac writes down the notes. The recording is not sent online.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandroom på denne Macen skriver ned tonene. Opptaket sendes ikke på nettet."
          }
        }
      }
    },
    "Bandroom on your computer couldn't finish the tab. Try again.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandroom på datamaskinen klarte ikke å gjøre ferdig tabben. Prøv igjen."
          }
        }
      }
    },
    "Bandroom on your computer didn't accept these choices. It may need an update.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandroom på datamaskinen godtok ikke disse valgene. Den trenger kanskje en oppdatering."
          }
        }
      }
    },
    "Bandroom on your computer is writing down the notes": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandroom på datamaskinen skriver ned tonene"
          }
        }
      }
    },
    "Bandroom on your computer writes down the notes. Open it there, and connect in Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandroom på datamaskinen skriver ned tonene. Åpne den der, og koble til i Innstillinger."
          }
        }
      }
    },
    "Bandroom on your computer writes down the notes. The recording is not sent online.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandroom på datamaskinen skriver ned tonene. Opptaket sendes ikke til nettet."

{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ (playing)": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (spiller)"
          }
        }
      }
    },
    "%@ didn't answer. Check that it's still open.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarte ikke. Sjekk at det fortsatt er åpent."
          }
        }
      }
    },
    "%@ has no place on your instrument here. Is the tuning right?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen plass på instrumentet ditt her. Er stemmingen riktig?"
          }
        }
      }
    },
    "%@ is higher than your highest fret. Is the tuning right?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er høyere enn det høyeste båndet ditt. Er stemmingen riktig?"
          }
        }
      }
    },
    "%@ is lower than your lowest string. Is the tuning right?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er lavere enn den laveste strengen din. Er stemmingen riktig?"
          }
        }
      }
    },
    "%@ string, fret %lld, %@.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ streng, bånd %lld, %@."
          }
        }
      }
    },
    "%@ string, open, %@.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ streng, åpen, %@."
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%@ · %@ · %@": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@"
          }
        }
      }
    },
    "%@. You can switch to another app: when the tab is ready, it is in Your songs while this device is connected to your computer.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Du kan bytte til en annen app: Når tabben er klar, ligger den i Sangene dine mens denne enheten er koblet til datamaskinen."
          }
        }
      }
    },
    "%@: one bar earlier": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: én takt tidligere"
          }
        }
      }
    },
    "%@: one bar later": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: én takt senere"
          }
        }
      }
    },

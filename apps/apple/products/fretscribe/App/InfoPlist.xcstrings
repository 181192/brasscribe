    },
    "NSAudioCaptureUsageDescription": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fretscribe tar opp lyden som spilles på denne Macen for å skrive den ned som tabb."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fretscribe skanner koden datamaskinen viser, for å koble seg til den."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fretscribe snakker med Bandroom på din egen datamaskin, som skriver ned tonene."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fretscribe tar opp spillingen din for å skrive den ned som tabb."
          }
        }
      }
    }
  },
  "version": "1.0"
}
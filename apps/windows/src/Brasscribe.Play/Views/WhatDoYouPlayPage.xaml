<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brasscribe.Play.Views.WhatDoYouPlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Brasscribe.Play.Views"
    NavigationCacheMode="Disabled">

    <!-- The one question after Get started: What do you play? Nothing is chosen for the player, and nothing is
         saved until Continue. "I conduct or listen" sets no part; "Not now" sets nothing and is not asked again. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Padding="40,36,40,32" Spacing="16" HorizontalAlignment="Center">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Heading" x:Uid="SeatHeading" Style="{StaticResource ScreenHeadingStyle}"
                           AutomationProperties.HeadingLevel="Level1" IsTabStop="True" />
                <Button x:Uid="SeatSkipButton" Grid.Column="1" Style="{StaticResource PlainButtonStyle}" VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.SkipSeatCommand}" />
            </Grid>
            <TextBlock x:Uid="SeatBody" Style="{StaticResource LeadStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <views:SeatPickerView x:Name="Picker" />

            <!-- Why Continue can't be pressed yet, as words beside it, not only a tooltip. -->
            <TextBlock Style="{StaticResource MutedStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       Text="{x:Bind ViewModel.FirstRunSeat.ContinueHint, Mode=OneWay, FallbackValue=''}" Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button x:Uid="SeatConductButton" Style="{StaticResource PlainButtonStyle}" Command="{x:Bind ViewModel.ConductOrListenCommand}" />
                <Button x:Name="ContinueButton" x:Uid="SeatContinueButton" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{x:Bind ViewModel.ContinueWithSeatCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

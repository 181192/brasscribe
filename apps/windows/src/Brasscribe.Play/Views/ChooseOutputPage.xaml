<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brasscribe.Play.Views.ChooseOutputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Brasscribe.Play.Core.ViewModels"
    xmlns:views="using:Brasscribe.Play.Views"
    NavigationCacheMode="Required">

    <!-- "How should the score be?": three questions, and nothing is arranged again until Show the score. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Padding="40,36,40,32" Spacing="12" HorizontalAlignment="Center">
            <TextBlock x:Uid="OutputOverline" Style="{StaticResource OverlineStyle}" />
            <TextBlock x:Name="Heading" x:Uid="OutputHeading" Style="{StaticResource ScreenHeadingStyle}"
                       AutomationProperties.HeadingLevel="Level1" IsTabStop="True" />
            <TextBlock x:Uid="OutputIntro" Style="{StaticResource LeadStyle}" Margin="0,0,0,24" />

            <Grid ColumnSpacing="32" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Which band? A solo take written for a seat is one part: the question goes, and one line says why.
                     "Who played this?" comes first on a solo take (a friend may have played it). -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsWhoPlayed, Mode=OneWay}" Margin="0,0,0,12">
                        <TextBlock x:Uid="WhoPlayedHeading" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <ComboBox x:Name="WhoPlayedBox" x:Uid="WhoPlayedBox" HorizontalAlignment="Stretch" SelectionChanged="OnWhoPlayedChanged" />
                        <TextBlock x:Uid="SoloOnePartNote" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.SoloGivesOnePart, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock x:Uid="OutputBandHeading" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2"
                               Visibility="{x:Bind ViewModel.ShowsLineupChoice, Mode=OneWay}" />
                    <RadioButtons x:Name="LineupChoices" x:Uid="LineupChoices" SelectionChanged="OnLineupChanged"
                                  Visibility="{x:Bind ViewModel.ShowsLineupChoice, Mode=OneWay}">
                        <!-- A whole-band recording is only made for the small band or the quartet: the full-band card is
                             dimmed and says why, like the quartet on a solo take. -->
                        <RadioButton x:Name="FullBandChoice" Style="{StaticResource ChoiceCardStyle}" MinHeight="72" Padding="16,12" Margin="0,0,0,8"
                                     x:Uid="LineupFullChoice"
                                     AutomationProperties.HelpText="{x:Bind ViewModel.FullHelpText, Mode=OneWay}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="LineupFullTitle" Style="{StaticResource LabelStyle}" FontSize="16"
                                           Opacity="{x:Bind views:Shown.Dimmed(ViewModel.FullAvailable), Mode=OneWay}" />
                                <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.FullDescription, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.FullBandYourPart, Mode=OneWay}"
                                           Visibility="{x:Bind views:Shown.HasText(ViewModel.FullBandYourPart), Mode=OneWay}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SmallBandChoice" Style="{StaticResource ChoiceCardStyle}" MinHeight="72" Padding="16,12" Margin="0,0,0,8"
                                     x:Uid="LineupSmallChoice">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="LineupSmallTitle" Style="{StaticResource LabelStyle}" FontSize="16" />
                                <TextBlock x:Uid="LineupSmallBody" Style="{StaticResource MutedStyle}" />
                                <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.SmallBandYourPart, Mode=OneWay}"
                                           Visibility="{x:Bind views:Shown.HasText(ViewModel.SmallBandYourPart), Mode=OneWay}" />
                            </StackPanel>
                        </RadioButton>
                        <!-- A solo take has no harmony for a quartet: the card stays focusable (IsEnabled would drop it from
                             the tab order), is dimmed, says why, and choosing it is undone with the reason read aloud. -->
                        <RadioButton x:Name="QuartetChoice" Style="{StaticResource ChoiceCardStyle}" MinHeight="72" Padding="16,12"
                                     x:Uid="LineupQuartetChoice"
                                     AutomationProperties.HelpText="{x:Bind ViewModel.QuartetHelpText, Mode=OneWay}">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="LineupQuartetTitle" Style="{StaticResource LabelStyle}" FontSize="16"
                                           Opacity="{x:Bind views:Shown.Dimmed(ViewModel.QuartetAvailable), Mode=OneWay}" />
                                <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.QuartetDescription, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.QuartetYourPart, Mode=OneWay}"
                                           Visibility="{x:Bind views:Shown.HasText(ViewModel.QuartetYourPart), Mode=OneWay}" />
                            </StackPanel>
                        </RadioButton>
                    </RadioButtons>
                    <!-- Who plays the tune? For a soloist recording in a band lineup, when the player's part can carry it. -->
                    <StackPanel Spacing="8" Margin="0,12,0,0" Visibility="{x:Bind ViewModel.ShowsTuneChoice, Mode=OneWay}">
                        <TextBlock x:Uid="TuneHeading" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <RadioButtons x:Name="TuneChoices" x:Uid="TuneChoices" SelectionChanged="OnTuneChanged">
                            <RadioButton x:Name="TuneLineupChoice" MinHeight="44" Content="{x:Bind ViewModel.TuneLineupLabel, Mode=OneWay}" />
                            <RadioButton x:Name="TuneSeatChoice" MinHeight="44" Content="{x:Bind ViewModel.TuneSeatLabel, Mode=OneWay}" />
                        </RadioButtons>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                    <!-- How hard? Three segments: As played / A bit easier / Easier. -->
                    <TextBlock x:Uid="OutputHardHeading" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource SegmentGroupStyle}" HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="EasierChoice" x:Uid="DifficultyEasier" Grid.Column="0" GroupName="Difficulty" Style="{StaticResource SegmentRadioStyle}"
                                         Checked="OnDifficultyChecked" Tag="2" IsEnabled="{x:Bind ViewModel.DifficultyAvailable, Mode=OneWay}" />
                            <RadioButton x:Name="StandardChoice" x:Uid="DifficultyStandard" Grid.Column="1" GroupName="Difficulty" Style="{StaticResource SegmentRadioStyle}"
                                         Checked="OnDifficultyChecked" Tag="1" IsEnabled="{x:Bind ViewModel.DifficultyAvailable, Mode=OneWay}" />
                            <RadioButton x:Name="FaithfulChoice" x:Uid="DifficultyFaithful" Grid.Column="2" GroupName="Difficulty" Style="{StaticResource SegmentRadioStyle}"
                                         Checked="OnDifficultyChecked" Tag="0" IsEnabled="{x:Bind ViewModel.DifficultyAvailable, Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="{StaticResource BcIconInfo}" FontSize="16" Foreground="{ThemeResource ScribeTextMutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock x:Uid="OutputHardTip" Style="{StaticResource MutedStyle}" MaxWidth="360" />
                    </StackPanel>

                    <!-- Key: − and + around the key's name. -->
                    <TextBlock x:Uid="OutputKeyHeading" Style="{StaticResource HeadlineStyle}" Margin="0,12,0,0" AutomationProperties.HeadingLevel="Level2" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Uid="KeyDownButton" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                Command="{x:Bind ViewModel.KeyDownCommand}" IsEnabled="{x:Bind ViewModel.KeyAvailable, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE738;" FontSize="12" />
                                <TextBlock x:Uid="KeyDownLabel" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="1" BorderBrush="{ThemeResource ScribeBorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource ScribeRadiusMd}"
                                Padding="14,8" Background="{ThemeResource ScribeSurfaceRaisedBrush}" AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="{x:Bind ViewModel.KeyLabel, Mode=OneWay}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelStyle}" FontSize="16" Text="{x:Bind ViewModel.KeyLabel, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.KeyDetail, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Button x:Uid="KeyUpButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                Command="{x:Bind ViewModel.KeyUpCommand}" IsEnabled="{x:Bind ViewModel.KeyAvailable, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock x:Uid="KeyUpLabel" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.UnavailableText, Mode=OneWay}"
                               Visibility="{x:Bind views:Shown.HasText(ViewModel.UnavailableText), Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="12" Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource MutedStyle}" VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                <Button x:Uid="OutputBackButton" Grid.Column="1" Style="{StaticResource PlainButtonStyle}" Click="OnBack" />
                <Button x:Name="ShowScoreButton" x:Uid="ShowScoreButton" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Click="OnShowScore" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

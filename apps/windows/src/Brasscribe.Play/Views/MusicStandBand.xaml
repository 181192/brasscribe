<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Brasscribe.Play.Views.MusicStandBand"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The music stand's persistent band (design/music-stand.md §4.1): the position as plain text (a
         status, not a control, so not a tab stop) at the leading edge, and ✕ Leave, the only thing here
         that looks like a button. It has its own row, so it never covers the music. -->
    <Grid x:Name="Band" x:Uid="StandBand" Padding="24,12" ColumnSpacing="16" Background="{ThemeResource ScribeBgBrush}"
          AutomationProperties.LandmarkType="Custom">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Position" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStyle}"
                   AutomationProperties.Name="{x:Bind Score.Stand.PositionName, Mode=OneWay}">
            <Run Text="{x:Bind Score.Stand.PositionTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource ScribeTextBrush}" />
            <Run Text=" · " Foreground="{ThemeResource ScribeTextMutedBrush}" />
            <Run Text="{x:Bind Score.Stand.PositionDetail, Mode=OneWay}" Foreground="{ThemeResource ScribeTextMutedBrush}" />
        </TextBlock>
        <Button x:Name="LeaveButton" x:Uid="StandLeaveButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}"
                MinHeight="48" Padding="18,8" CornerRadius="24" Background="{ThemeResource ScribeSurfaceRaisedBrush}"
                VerticalAlignment="Center" Click="OnLeave">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{StaticResource BcIconClose}" FontSize="14" />
                <TextBlock x:Uid="StandLeaveLabel" Style="{StaticResource LabelStyle}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Brasscribe.Play.Views.MusicStandLayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Brasscribe.Play.Views">

    <!-- The music stand's control layer (design/music-stand.md §4): a card at the bottom centre with
         ‹ page · ⏮ bar · Play · bar ⏭ · page › · − Speed + · Repeat · Only my part. Hidden means
         Collapsed, so it leaves the tab order and the UIA tree. The rows stack at large text sizes, and the
         card grows upwards; it never clips. Play is the only ink control; the page buttons have a tonal
         well so they read differently from the bar buttons. -->
    <Grid>
        <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,20" Padding="14,10"
                Background="{ThemeResource BcSurfaceRaisedBrush}" BorderBrush="{ThemeResource BcBorderStrongBrush}" BorderThickness="1"
                CornerRadius="{StaticResource BcRadiusLg}"
                Visibility="{x:Bind views:Shown.If(Score.Stand.IsLayerShown), Mode=OneWay}">
            <Grid x:Name="Controls" x:Uid="StandLayer" AutomationProperties.LandmarkType="Custom">
                <StackPanel x:Name="Rows" Orientation="Horizontal" Spacing="16">
                    <StackPanel x:Name="Transport" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button x:Name="PreviousPageButton" x:Uid="StandPreviousPage" Style="{StaticResource IconButtonStyle}" Width="48" Height="48"
                                CornerRadius="24" Background="{ThemeResource BcSecondaryBrush}" Click="OnPreviousPage">
                            <FontIcon Glyph="{StaticResource BcIconPagePrevious}" FontSize="16" />
                        </Button>
                        <Button x:Uid="StandPreviousBar" Style="{StaticResource IconButtonStyle}" Width="48" Height="48"
                                Command="{x:Bind Score.Player.PreviousBarCommand, Mode=OneWay}">
                            <FontIcon Glyph="{StaticResource BcIconPreviousBar}" FontSize="16" />
                        </Button>
                        <Button x:Name="PlayButton" x:Uid="StandPlayPause" Style="{StaticResource PlayButtonStyle}"
                                Command="{x:Bind Score.Player.PlayPauseCommand, Mode=OneWay}">
                            <Grid>
                                <FontIcon Glyph="{StaticResource BcIconPlay}" Visibility="{x:Bind views:Shown.Not(Score.Player.IsPlaying), Mode=OneWay}" />
                                <FontIcon Glyph="{StaticResource BcIconPause}" Visibility="{x:Bind views:Shown.If(Score.Player.IsPlaying), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button x:Uid="StandNextBar" Style="{StaticResource IconButtonStyle}" Width="48" Height="48"
                                Command="{x:Bind Score.Player.NextBarCommand, Mode=OneWay}">
                            <FontIcon Glyph="{StaticResource BcIconNextBar}" FontSize="16" />
                        </Button>
                        <Button x:Name="NextPageButton" x:Uid="StandNextPage" Style="{StaticResource IconButtonStyle}" Width="48" Height="48"
                                CornerRadius="24" Background="{ThemeResource BcSecondaryBrush}" Click="OnNextPage">
                            <FontIcon Glyph="{StaticResource BcIconPageNext}" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <!-- Speed: two steppers around the value, 25 to 150 percent (no slider, WCAG 2.5.7). -->
                    <Border x:Name="Speed" BorderBrush="{ThemeResource BcBorderStrongBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource BcRadiusMd}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Uid="StandSlower" Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Click="OnSlower">
                                <FontIcon Glyph="{StaticResource BcIconMinus}" FontSize="14" />
                            </Button>
                            <TextBlock Style="{StaticResource LabelStyle}" VerticalAlignment="Center" MinWidth="96" TextAlignment="Center"
                                       Text="{x:Bind Score.Stand.SpeedText, Mode=OneWay}" />
                            <Button x:Uid="StandFaster" Style="{StaticResource IconButtonStyle}" Width="48" Height="48" Click="OnFaster">
                                <FontIcon Glyph="{StaticResource BcIconPlus}" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Repeat and Only my part: system.md §1.1 toggles (off = outline; on = tonal, ink edge, ✓). -->
                    <StackPanel x:Name="Toggles" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ToggleButton x:Name="RepeatToggle" x:Uid="StandRepeatToggle" Style="{StaticResource TransportToggleStyle}"
                                      IsChecked="{x:Bind Score.Player.IsLooping, Mode=OneWay}" Click="OnRepeat"
                                      AutomationProperties.Name="{x:Bind Score.Stand.RepeatText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="{StaticResource BcIconLoop}" FontSize="16" />
                                <TextBlock Text="{x:Bind Score.Stand.RepeatText, Mode=OneWay}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="OnlyMineToggle" x:Uid="StandOnlyMine" Style="{StaticResource TransportToggleStyle}"
                                      IsChecked="{x:Bind Score.Stand.OnlyMyPart, Mode=TwoWay}"
                                      Visibility="{x:Bind views:Shown.If(Score.Stand.HasMyPart), Mode=OneWay}">
                            <TextBlock x:Uid="StandOnlyMineLabel" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The first time the layer hides: how to bring it back. It takes no focus and a tap dismisses it (WCAG 1.4.13). -->
        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,28" Padding="16,10"
                Background="{ThemeResource BcSurfaceRaisedBrush}" BorderBrush="{ThemeResource BcBorderStrongBrush}" BorderThickness="1"
                CornerRadius="{StaticResource BcRadiusMd}" IsHitTestVisible="False"
                Visibility="{x:Bind views:Shown.If(Score.Stand.IsHintShown), Mode=OneWay}">
            <TextBlock x:Uid="StandHint" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Brasscribe.Play.Views.TranscriptionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Brasscribe.Play.Core.ViewModels">

    <StackPanel MaxWidth="720" Padding="24" Spacing="12" HorizontalAlignment="Center">
        <TextBlock x:Name="Heading" x:Uid="TranscribeHeading" Style="{StaticResource ScreenHeadingStyle}"
                   AutomationProperties.HeadingLevel="Level1" IsTabStop="True" />
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

        <!-- Progress: a determinate bar (static steps when motion is reduced) with the percentage also in text. -->
        <ProgressBar x:Name="Progress" x:Uid="TranscribeProgress" Minimum="0" Maximum="100" Height="12"
                     Value="{x:Bind ViewModel.Percent, Mode=OneWay}" />
        <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Bind vm:Screens.Percent(ViewModel.Percent), Mode=OneWay}" />
        <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Bind ViewModel.StageText, Mode=OneWay}" />
        <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.EtaText, Mode=OneWay}" />
        <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.DeviceText, Mode=OneWay}" />

        <InfoBar x:Uid="TranscribeErrorBar" Severity="Error" IsClosable="False"
                 IsOpen="{x:Bind vm:Screens.HasText(ViewModel.ErrorText), Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />

        <Button x:Name="CancelButton" x:Uid="CancelTranscriptionButton" Style="{StaticResource ActionButtonStyle}"
                Click="OnCancelClick" AccessKey="X" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
    </StackPanel>
</UserControl>

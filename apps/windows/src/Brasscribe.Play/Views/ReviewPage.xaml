<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brasscribe.Play.Views.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Brasscribe.Play.Core.ViewModels"
    xmlns:views="using:Brasscribe.Play.Views"
    NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <!-- Space listens, K keeps (single keys only while no text box has focus). -->
        <KeyboardAccelerator Key="K" Invoked="OnKeepKey" />
        <KeyboardAccelerator Key="Space" Invoked="OnListenKey" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The notes to check, by part then bar; kept ones show a check. -->
        <Border Background="{ThemeResource BcSurfaceBrush}" BorderBrush="{ThemeResource BcBorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowSpacing="8" Padding="12,20,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8" Padding="12,0">
                    <TextBlock Style="{StaticResource OverlineStyle}" Text="{x:Bind ViewModel.CountHeading, Mode=OneWay}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <!-- Triage: your part first (very unsure first); the count follows the choice. -->
                    <TextBlock Style="{StaticResource BodyStyle}" FontSize="14" Text="{x:Bind ViewModel.TriageText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasMyPart, Mode=OneWay}" />
                    <Border Style="{StaticResource SegmentGroupStyle}" HorizontalAlignment="Left" x:Uid="ReviewScope"
                            Visibility="{x:Bind ViewModel.HasMyPart, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <RadioButton x:Name="MyPartScope" GroupName="ReviewScope" Style="{StaticResource SegmentRadioStyle}" Checked="OnScopeChecked"
                                         Content="{x:Bind ViewModel.MyPartScopeLabel, Mode=OneWay}" />
                            <RadioButton x:Name="AllPartsScope" GroupName="ReviewScope" Style="{StaticResource SegmentRadioStyle}" Checked="OnScopeChecked"
                                         Content="{x:Bind ViewModel.AllPartsScopeLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <!-- The legend: "?" uncertain, boxed "?" very uncertain. -->
                    <StackPanel Orientation="Horizontal" Spacing="16" x:Uid="ReviewLegend">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="?" FontWeight="Bold" Foreground="{ThemeResource BcUncertainBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Uid="LegendUncertain" Style="{StaticResource MutedStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border BorderBrush="{ThemeResource BcVeryUncertainBrush}" BorderThickness="1.5" CornerRadius="2" Width="18" Height="18">
                                <TextBlock Text="?" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource BcVeryUncertainBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Uid="LegendVeryUncertain" Style="{StaticResource MutedStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <ListView x:Name="NoteList" x:Uid="ReviewList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnNoteSelected">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:ReviewGroup">
                                    <TextBlock Text="{x:Bind PartName}" Style="{StaticResource OverlineStyle}" AutomationProperties.HeadingLevel="Level3" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReviewItem">
                            <StackPanel Orientation="Horizontal" Spacing="12" MinHeight="40" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <FontIcon Glyph="{StaticResource BcIconDone}" FontSize="14" Foreground="{ThemeResource BcTextMutedBrush}"
                                              Visibility="{x:Bind IsKept, Mode=OneWay}" />
                                    <TextBlock Text="?" FontWeight="Bold" Foreground="{ThemeResource BcUncertainBrush}" HorizontalAlignment="Center"
                                               Visibility="{x:Bind views:Shown.UncertainOpen(IsKept, IsVeryUncertain), Mode=OneWay}" />
                                    <Border BorderBrush="{ThemeResource BcVeryUncertainBrush}" BorderThickness="1.5" CornerRadius="2"
                                            Visibility="{x:Bind views:Shown.VeryUncertainOpen(IsKept, IsVeryUncertain), Mode=OneWay}">
                                        <TextBlock Text="?" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource BcVeryUncertainBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind ListName}" Style="{StaticResource BodyStyle}" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- One note at a time. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="880" Padding="40,36,40,32" Spacing="12" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource OverlineStyle}" Text="{x:Bind ViewModel.Overline, Mode=OneWay}" />
                <TextBlock x:Name="Heading" Style="{StaticResource ScreenHeadingStyle}" AutomationProperties.HeadingLevel="Level1" IsTabStop="True"
                           Text="{x:Bind ViewModel.Heading, Mode=OneWay}" />
                <!-- Many marks: most are probably right; start with the very unsure ones. -->
                <Border Style="{StaticResource CardStyle}" Background="{ThemeResource BcSurfaceBrush}" Padding="14,10"
                        Visibility="{x:Bind ViewModel.HasLead, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="{StaticResource BcIconInfo}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource BodyStyle}" FontSize="15" Text="{x:Bind ViewModel.LeadText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <!-- The bars around the note, drawn with the same "?" marks as the score. -->
                <Border Style="{StaticResource CardStyle}" Padding="16" MinHeight="180">
                    <Image x:Name="Snippet" x:Uid="ReviewSnippet" Stretch="Uniform" MaxHeight="220" HorizontalAlignment="Left" />
                </Border>
                <Grid ColumnSpacing="16" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource BcTitle2TextBlockStyle}" Foreground="{ThemeResource BcTextBrush}" Text="{x:Bind ViewModel.NoteLine, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource LeadStyle}" Text="{x:Bind ViewModel.LevelLine, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                        <!-- "Listen to this bar" becomes "Stop" while the bar plays. Both labels share one cell, the hidden
                             one transparent, so the button keeps its place and size; the accessible name follows the label. -->
                        <Button x:Name="ListenButton" x:Uid="ReviewListenButton" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.ListenCommand}" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind ViewModel.ListenLabel, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{StaticResource BcIconListenBar}" FontSize="16" AutomationProperties.AccessibilityView="Raw"
                                          Opacity="{x:Bind vm:Screens.OpaqueUnless(ViewModel.IsListening), Mode=OneWay}" />
                                <FontIcon Glyph="{StaticResource BcIconStop}" FontSize="16" AutomationProperties.AccessibilityView="Raw"
                                          Opacity="{x:Bind vm:Screens.Opaque(ViewModel.IsListening), Mode=OneWay}" />
                                <TextBlock x:Uid="ReviewListenLabel" Grid.Column="1" AutomationProperties.AccessibilityView="Raw"
                                           Opacity="{x:Bind vm:Screens.OpaqueUnless(ViewModel.IsListening), Mode=OneWay}" />
                                <TextBlock x:Uid="ReviewStopLabel" Grid.Column="1" AutomationProperties.AccessibilityView="Raw"
                                           Opacity="{x:Bind vm:Screens.Opaque(ViewModel.IsListening), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button x:Name="ChangeNoteButton" x:Uid="ReviewChangeNoteButton" Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnChangeNote" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.HasCurrent, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource BcIconTranspose}" FontSize="16" />
                                <TextBlock x:Uid="ReviewChangeNoteLabel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- How sure Brasscribe is, and what each transcriber heard at this note. -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{x:Bind ViewModel.HasEvidence, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock x:Uid="ReviewHowSure" Style="{StaticResource HeadlineStyle}" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource HeadlineStyle}" Text="{x:Bind ViewModel.ConfidenceText, Mode=OneWay}" />
                        </Grid>
                        <ProgressBar x:Uid="ReviewConfidence" Maximum="100" Value="{x:Bind ViewModel.ConfidencePercent, Mode=OneWay}"
                                     Foreground="{ThemeResource BcTextBrush}" Background="{ThemeResource BcBorderBrush}" MinHeight="4"
                                     AutomationProperties.ItemStatus="{x:Bind ViewModel.ConfidenceText, Mode=OneWay}" />
                        <Border Height="1" Background="{ThemeResource BcBorderBrush}" Margin="0,4" />
                        <TextBlock x:Uid="ReviewHeardHeading" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Heard}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EvidenceRow">
                                    <Grid ColumnSpacing="12" MinHeight="32" AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{StaticResource BcIconDone}" FontSize="14" Foreground="{ThemeResource BcTextMutedBrush}"
                                                  Visibility="{x:Bind Agrees}" AutomationProperties.AccessibilityView="Raw" />
                                        <FontIcon Glyph="{StaticResource BcIconInfo}" FontSize="14" Foreground="{ThemeResource BcTextMutedBrush}"
                                                  Visibility="{x:Bind Differs}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Heard}" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                                   Visibility="{x:Bind Agrees}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Heard}" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Visibility="{x:Bind Differs}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Height="1" Background="{ThemeResource BcBorderBrush}" Margin="0,16" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="ReviewKeys" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
                    <Button x:Name="FinishLaterButton" Grid.Column="1" Style="{StaticResource PlainButtonStyle}" Click="OnFinishLater"
                            Content="{x:Bind ViewModel.FinishLaterText, Mode=OneWay}" />
                    <Button x:Name="KeepBarButton" x:Uid="ReviewKeepBarButton" Grid.Column="2" Style="{StaticResource ActionButtonStyle}" MinHeight="48"
                            Command="{x:Bind ViewModel.KeepRestOfBarCommand}" Content="{x:Bind ViewModel.KeepBarText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanKeepBar, Mode=OneWay}" />
                    <Button x:Name="SkipButton" x:Uid="ReviewSkipButton" Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.SkipCommand}" />
                    <Button x:Name="KeepButton" x:Uid="ReviewKeepButton" Grid.Column="4" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.KeepCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource BcIconMarkChecked}" FontSize="16" />
                            <TextBlock x:Uid="ReviewKeepLabel" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

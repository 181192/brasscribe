<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Brasscribe.Play.Views.ScoreScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Brasscribe.Play.Controls"
    xmlns:vm="using:Brasscribe.Play.Core.ViewModels">

    <Grid Padding="12,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Result heading: focus lands here when transcription completes. -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="Heading" Style="{StaticResource ScreenHeadingStyle}" Margin="0"
                       AutomationProperties.HeadingLevel="Level1" IsTabStop="True"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.UncertainText, Mode=OneWay}" />
            <TextBlock x:Uid="AdLibNotice" Style="{StaticResource MutedStyle}" Visibility="{x:Bind ViewModel.HasFreeTime, Mode=OneWay}" />
        </StackPanel>

        <!-- Toolbar: part, pitch, zoom, view. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="PartPicker" x:Uid="PartPicker" MinWidth="220" SelectionChanged="OnPartSelected" AccessKey="P" />
            <ToggleSwitch x:Name="ConcertPitchSwitch" x:Uid="ConcertPitchSwitch"
                          IsOn="{x:Bind ViewModel.ConcertPitch, Mode=TwoWay}" AccessKey="C" />
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                <Button x:Uid="ZoomOutButton" Style="{StaticResource ActionButtonStyle}" Click="OnZoomOut">
                    <FontIcon Glyph="&#xE71F;" />
                </Button>
                <NumberBox x:Name="ZoomBox" x:Uid="ZoomBox" Minimum="50" Maximum="400" SmallChange="10" LargeChange="50"
                           SpinButtonPlacementMode="Hidden" Width="90"
                           Value="{x:Bind ViewModel.ZoomPercent, Mode=TwoWay}" />
                <Button x:Uid="ZoomInButton" Style="{StaticResource ActionButtonStyle}" Click="OnZoomIn">
                    <FontIcon Glyph="&#xE8A3;" />
                </Button>
            </StackPanel>
            <ToggleButton x:Name="TalkingScoreToggle" x:Uid="TalkingScoreToggle" Style="{StaticResource TransportToggleStyle}"
                          IsChecked="{x:Bind ViewModel.ShowTalkingScore, Mode=TwoWay}" AccessKey="V" VerticalAlignment="Bottom" />
            <DropDownButton x:Uid="OutputOptionsButton" VerticalAlignment="Bottom" MinHeight="44" AccessKey="O">
                <DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="8" MinWidth="280">
                            <TextBlock x:Uid="OutputHeading" Style="{StaticResource SectionHeadingStyle}" Margin="0"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <ComboBox x:Name="LineupBox" x:Uid="LineupBox" SelectedIndex="0" SelectionChanged="OnLineupChanged">
                                <ComboBoxItem x:Uid="LineupFull" />
                                <ComboBoxItem x:Uid="LineupMinimal" />
                            </ComboBox>
                            <ComboBox x:Name="DifficultyBox" x:Uid="DifficultyBox" SelectedIndex="0" SelectionChanged="OnDifficultyChanged"
                                      IsEnabled="{x:Bind Output.DifficultyAvailable, Mode=OneWay}">
                                <ComboBoxItem x:Uid="DifficultyFaithful" />
                                <ComboBoxItem x:Uid="DifficultyStandard" />
                                <ComboBoxItem x:Uid="DifficultyEasier" />
                            </ComboBox>
                            <!-- Filled from OutputOptionsViewModel.Keys with localised key names. -->
                            <ComboBox x:Name="KeyBox" x:Uid="KeyBox" SelectionChanged="OnKeyChanged"
                                      IsEnabled="{x:Bind Output.KeyAvailable, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind Output.UnavailableText, Mode=OneWay}" />
                            <Button x:Uid="ApplyOutputButton" Style="{StaticResource ActionButtonStyle}" Click="OnApplyOutput" />
                            <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Bind Output.StatusText, Mode=OneWay}" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <!-- Score area and mixer. -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <controls:ScoreView x:Name="Notation" x:Uid="ScoreNotation" Grid.Column="0"
                                Background="{ThemeResource BcBackgroundBrush}" BorderBrush="{ThemeResource BcTextMutedBrush}" BorderThickness="1"
                                Visibility="{x:Bind vm:Screens.Not(ViewModel.ShowTalkingScore), Mode=OneWay}">
                <controls:ScoreView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="ListenToBarItem" Click="OnListenToBar" KeyboardAcceleratorTextOverride="P" />
                        <MenuFlyoutItem x:Uid="MarkCheckedItem" Click="OnMarkChecked" KeyboardAcceleratorTextOverride="C" />
                        <MenuFlyoutItem x:Uid="ReadBarItem" Click="OnReadBar" KeyboardAcceleratorTextOverride="R" />
                        <MenuFlyoutItem x:Uid="GoToBarItem" Click="OnGoToBarItem" KeyboardAcceleratorTextOverride="Ctrl+G" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="LoopStartItem" Click="OnLoopStartItem" KeyboardAcceleratorTextOverride="[" />
                        <MenuFlyoutItem x:Uid="LoopEndItem" Click="OnLoopEndItem" KeyboardAcceleratorTextOverride="]" />
                    </MenuFlyout>
                </controls:ScoreView.ContextFlyout>
            </controls:ScoreView>

            <!-- Talking-score view: the same strings as the score cursor, one list item per event. -->
            <ListView x:Name="TalkingList" x:Uid="TalkingList" Grid.Column="0"
                      ItemsSource="{x:Bind ViewModel.TalkingLines}" SelectionMode="Single"
                      SelectedIndex="{x:Bind ViewModel.CurrentLineIndex, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.ShowTalkingScore, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Padding="0,6" AutomationProperties.Name="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Mixer: mute and solo are toggle buttons (Toggle pattern), volume a slider (RangeValue). -->
            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Uid="MixerHeading" Style="{StaticResource SectionHeadingStyle}" Margin="0"
                           AutomationProperties.HeadingLevel="Level2" />
                <ListView x:Name="Mixer" x:Uid="Mixer" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Player.Parts}" SelectionMode="None"
                          IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MixerPartViewModel">
                            <Grid ColumnSpacing="4" Padding="0,4" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleButton Grid.Column="1" Content="M" MinWidth="44" MinHeight="44"
                                              IsChecked="{x:Bind IsMuted, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind MuteLabel}" />
                                <ToggleButton Grid.Column="2" Content="S" MinWidth="44" MinHeight="44"
                                              IsChecked="{x:Bind IsSolo, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind SoloLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Player bar. -->
        <Grid Grid.Row="3" Background="{ThemeResource BcSurfaceBrush}" Padding="8" ColumnSpacing="8" RowSpacing="4"
              AutomationProperties.LandmarkType="Custom" x:Uid="PlayerBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4" Grid.Column="0">
                <Button x:Name="PlayButton" x:Uid="PlayPauseButton" Style="{StaticResource ActionButtonStyle}"
                        Command="{x:Bind ViewModel.Player.PlayPauseCommand}">
                    <FontIcon Glyph="&#xE768;" />
                </Button>
                <Button x:Uid="StopButton" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Player.StopCommand}">
                    <FontIcon Glyph="&#xE71A;" />
                </Button>
                <Button x:Uid="ListenBarButton" Style="{StaticResource ActionButtonStyle}" Click="OnListenToBar" />
                <Button x:Uid="MarkCheckedButton" Style="{StaticResource ActionButtonStyle}" Click="OnMarkChecked" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4" Grid.Column="1" VerticalAlignment="Center">
                <Button x:Uid="SlowerButton" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Player.SlowerBy5Command}" Content="−" />
                <Slider x:Name="SpeedSlider" x:Uid="SpeedSlider" Minimum="25" Maximum="150" SmallChange="5" LargeChange="25"
                        StepFrequency="5" TickFrequency="25" TickPlacement="Outside" Width="180"
                        Value="{x:Bind ViewModel.Player.SpeedPercent, Mode=TwoWay}" />
                <Button x:Uid="FasterButton" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Player.FasterBy5Command}" Content="+" />
            </StackPanel>

            <!-- Loop by bar numbers: no dragging needed (WCAG 2.5.7). -->
            <StackPanel Orientation="Horizontal" Spacing="4" Grid.Column="2" VerticalAlignment="Center">
                <NumberBox x:Name="LoopStartBox" x:Uid="LoopStartBox" Minimum="1" Maximum="{x:Bind ViewModel.Player.LastBar, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.Player.LoopStart, Mode=TwoWay}" Width="110" />
                <NumberBox x:Name="LoopEndBox" x:Uid="LoopEndBox" Minimum="1" Maximum="{x:Bind ViewModel.Player.LastBar, Mode=OneWay}"
                           SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.Player.LoopEnd, Mode=TwoWay}" Width="110" />
                <Button x:Uid="SetLoopButton" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Player.SetLoopCommand}" />
                <Button x:Uid="ClearLoopButton" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Player.ClearLoopCommand}" />
                <TextBlock Style="{StaticResource MutedStyle}" VerticalAlignment="Center" Text="{x:Bind ViewModel.Player.LoopText, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4" Grid.Column="3" VerticalAlignment="Center">
                <ToggleButton x:Uid="CountInToggle" Style="{StaticResource TransportToggleStyle}" IsChecked="{x:Bind ViewModel.Player.CountIn, Mode=TwoWay}" />
                <ToggleButton x:Uid="MetronomeToggle" Style="{StaticResource TransportToggleStyle}" IsChecked="{x:Bind ViewModel.Player.Metronome, Mode=TwoWay}" />
                <NumberBox x:Uid="TransposeBox" Minimum="-12" Maximum="12" SpinButtonPlacementMode="Compact" Width="110"
                           Value="{x:Bind ViewModel.Player.Transpose, Mode=TwoWay, Converter={StaticResource IntToDouble}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4" Grid.Column="4" VerticalAlignment="Center">
                <ToggleButton x:Name="PlayAlongToggle" x:Uid="PlayAlongToggle" Style="{StaticResource TransportToggleStyle}"
                              IsChecked="{x:Bind ViewModel.Player.IsPlayingAlong, Mode=OneWay}" Click="OnPlayAlong" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brasscribe.Play.Views.ErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Brasscribe.Play.Core.ViewModels"
    NavigationCacheMode="Required">

    <!-- An error with a way forward: what happened, why, what to do, and the way out (primary last, bottom right). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Padding="40,96,40,32" Spacing="16" HorizontalAlignment="Center" MinWidth="520">
            <Border Style="{StaticResource IconWellStyle}" Width="56" Height="56" HorizontalAlignment="Left">
                <FontIcon Glyph="{StaticResource BcIconComputer}" FontSize="22" Foreground="{ThemeResource BcErrorBrush}" />
            </Border>
            <TextBlock x:Name="Heading" Style="{StaticResource ScreenHeadingStyle}" AutomationProperties.HeadingLevel="Level1" IsTabStop="True"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <TextBlock Style="{StaticResource LeadStyle}" Text="{x:Bind ViewModel.Reason, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}" IsTabStop="False" x:Uid="ErrorSteps">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Style="{StaticResource BodyStyle}" Margin="0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnSpacing="12" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="AlternativeButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind ViewModel.ChooseAnotherCommand}" Content="{x:Bind ViewModel.SecondaryLabel, Mode=OneWay}" />
                <Button x:Name="RetryButton" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.TryAgainCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{StaticResource BcIconRetry}" FontSize="16" />
                        <TextBlock Text="{x:Bind ViewModel.PrimaryLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Commands, addresses and codes only here, collapsed. -->
            <Expander x:Name="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,16,0,0"
                      Header="{x:Bind ViewModel.DetailsHeading, Mode=OneWay}"
                      Visibility="{x:Bind vm:Screens.HasText(ViewModel.Details), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Details, Mode=OneWay}" Style="{StaticResource MutedStyle}" IsTextSelectionEnabled="True"
                           FontFamily="Cascadia Mono, Consolas" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brasscribe.Play.Views.FirstRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <!-- First run: one screen, three points, [Get started]. Permissions are asked when first needed. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- The brass-tint hero: the mark and the headline with the brass italic. -->
            <Border Background="{ThemeResource ScribeBrandTintBrush}" Padding="40,48,40,40">
                <StackPanel MaxWidth="720" HorizontalAlignment="Center" Spacing="24">
                    <Image Source="ms-appx:///Assets/Brand/mark-brass.svg" Width="56" Height="56" HorizontalAlignment="Left"
                           AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="Heading" Style="{StaticResource HeroHeadingStyle}" AutomationProperties.HeadingLevel="Level1" IsTabStop="True">
                        <Run x:Uid="FirstRunHeadingLead" />
                        <Run x:Uid="FirstRunHeadingBrass" FontFamily="{StaticResource BcDisplayItalicFontFamily}" FontStyle="Italic"
                             Foreground="{ThemeResource ScribeBrandTextBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" MaxWidth="720" Padding="40,32" Spacing="28" HorizontalAlignment="Center">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconWellStyle}" Width="48" Height="48" VerticalAlignment="Top">
                        <FontIcon Glyph="{StaticResource BcIconRecordMic}" FontSize="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Uid="FirstRunPoint1Title" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Uid="FirstRunPoint1Body" Style="{StaticResource LeadStyle}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- The boxed "?" is taught here, in its very-uncertain colour. -->
                    <Border Style="{StaticResource IconWellStyle}" Width="48" Height="48" VerticalAlignment="Top">
                        <Border BorderBrush="{ThemeResource BcVeryUncertainBrush}" BorderThickness="1.5" CornerRadius="2" Width="22" Height="22"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="?" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource BcVeryUncertainBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Uid="FirstRunPoint2Title" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Uid="FirstRunPoint2Body" Style="{StaticResource LeadStyle}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconWellStyle}" Width="48" Height="48" VerticalAlignment="Top">
                        <FontIcon Glyph="{StaticResource BcIconPlayAlong}" FontSize="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Uid="FirstRunPoint3Title" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Uid="FirstRunPoint3Body" Style="{StaticResource LeadStyle}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="{StaticResource BcIconInfo}" FontSize="16" Foreground="{ThemeResource ScribeTextMutedBrush}" />
                        <TextBlock x:Uid="FirstRunPrivacy" Style="{StaticResource MutedStyle}" />
                    </StackPanel>
                    <Button x:Name="GetStartedButton" x:Uid="GetStartedButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.GetStartedCommand}" />
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

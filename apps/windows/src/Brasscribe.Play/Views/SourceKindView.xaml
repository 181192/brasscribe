<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Brasscribe.Play.Views.SourceKindView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Brasscribe.Play.Core.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Padding="24" Spacing="12" HorizontalAlignment="Center">
            <TextBlock x:Name="Heading" x:Uid="KindHeading" Style="{StaticResource ScreenHeadingStyle}"
                       AutomationProperties.HeadingLevel="Level1" IsTabStop="True" />
            <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.Source.DisplayName, Mode=OneWay, FallbackValue=''}" />
            <TextBlock x:Uid="KindIntro" Style="{StaticResource BodyStyle}" />

            <!-- A radio group: arrows move between answers, "1 of 4" is announced; the app never picks one silently. -->
            <RadioButtons x:Name="Options" x:Uid="KindOptions" ItemsSource="{x:Bind ViewModel.Options}"
                          SelectionChanged="OnSelectionChanged" MaxColumns="1">
                <RadioButtons.ItemTemplate>
                    <DataTemplate x:DataType="vm:SourceKindOption">
                        <RadioButton IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind Label}"
                                     AutomationProperties.HelpText="{x:Bind Description, Mode=OneWay}">
                            <StackPanel Spacing="2" Padding="0,4">
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource MutedStyle}" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </RadioButtons.ItemTemplate>
            </RadioButtons>

            <Button x:Name="ContinueButton" x:Uid="ContinueButton" Style="{StaticResource BigActionButtonStyle}"
                    Command="{x:Bind ViewModel.ContinueCommand}" AccessKey="C" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

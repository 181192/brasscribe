<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Brasscribe.Play.Views.StartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Brasscribe.Play.Core.ViewModels"
    xmlns:capture="using:Brasscribe.Play.Core.Capture"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Padding="24" Spacing="12" HorizontalAlignment="Center">
            <TextBlock x:Name="Heading" x:Uid="StartHeading" Style="{StaticResource ScreenHeadingStyle}"
                       AutomationProperties.HeadingLevel="Level1" IsTabStop="True" />
            <TextBlock x:Uid="StartIntro" Style="{StaticResource BodyStyle}" />

            <Button x:Name="ImportButton" x:Uid="ImportButton" Style="{StaticResource BigActionButtonStyle}"
                    Command="{x:Bind ViewModel.ImportCommand}" AccessKey="I">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" />
                    <TextBlock x:Uid="ImportButtonLabel" />
                </StackPanel>
            </Button>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          x:Uid="DecodingProgress" HorizontalAlignment="Left" />

            <TextBlock x:Uid="RecordHeading" Style="{StaticResource SectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Button x:Name="RecordMicButton" x:Uid="RecordMicButton" Style="{StaticResource BigActionButtonStyle}"
                    Command="{x:Bind ViewModel.RecordMicrophoneCommand}" AccessKey="M">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE720;" />
                    <TextBlock x:Uid="RecordMicButtonLabel" />
                </StackPanel>
            </Button>
            <Button x:Name="RecordSystemButton" x:Uid="RecordSystemButton" Style="{StaticResource BigActionButtonStyle}"
                    Command="{x:Bind ViewModel.RecordSystemAudioCommand}" AccessKey="Y">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7F5;" />
                    <TextBlock x:Uid="RecordSystemButtonLabel" />
                </StackPanel>
            </Button>

            <!-- Per-app capture: only on Windows builds with process loopback. -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SupportsAppCapture}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AppPicker" x:Uid="AppPicker" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.Apps}" SelectionChanged="OnAppSelected"
                              DropDownOpened="OnAppPickerOpened">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="capture:AudioApp">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Uid="RefreshAppsButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshAppsCommand}">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </Grid>
                <Button x:Name="RecordAppButton" x:Uid="RecordAppButton" Style="{StaticResource BigActionButtonStyle}"
                        Command="{x:Bind ViewModel.RecordAppCommand}" AccessKey="A">
                    <TextBlock x:Uid="RecordAppButtonLabel" />
                </Button>
            </StackPanel>
            <TextBlock x:Uid="AppCaptureUnavailable" Style="{StaticResource MutedStyle}"
                       Visibility="{x:Bind vm:Screens.Not(ViewModel.SupportsAppCapture)}" />

            <!-- Recording state: level meter with a plain-language value, elapsed time and Stop. -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.RecordingTime, Mode=OneWay}"
                           x:Uid="RecordingTime" />
                <ProgressBar x:Name="LevelMeter" x:Uid="LevelMeter" Minimum="0" Maximum="1" Height="12"
                             Value="{x:Bind ViewModel.InputLevel, Mode=OneWay}"
                             AutomationProperties.ItemStatus="{x:Bind ViewModel.InputLevelText, Mode=OneWay}" />
                <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Bind ViewModel.InputLevelText, Mode=OneWay}" />
                <Button x:Name="StopButton" x:Uid="StopRecordingButton" Style="{StaticResource BigActionButtonStyle}"
                        Command="{x:Bind ViewModel.StopRecordingCommand}" AccessKey="T" />
            </StackPanel>

            <!-- Notice: protected content or nothing playing. Shown and announced, never silent. -->
            <InfoBar x:Uid="CaptureNotice" Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind vm:Screens.HasText(ViewModel.NoticeText), Mode=OneWay}"
                     Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}" />
            <InfoBar x:Uid="StartError" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind vm:Screens.HasText(ViewModel.ErrorText), Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />

            <TextBlock x:Uid="DrmNote" Style="{StaticResource MutedStyle}" />
            <TextBlock x:Uid="LinkNote" Style="{StaticResource MutedStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

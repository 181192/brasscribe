<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Brasscribe.Play.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Brasscribe.Play.Core.ViewModels"
    xmlns:capture="using:Brasscribe.Play.Core.Capture"
    NavigationCacheMode="Required"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Padding="40,40,40,32" Spacing="16" HorizontalAlignment="Center">
            <!-- The greeting in the display face, "a score." in the brass italic. -->
            <TextBlock x:Name="Heading" Style="{StaticResource HeroHeadingStyle}" AutomationProperties.HeadingLevel="Level1" IsTabStop="True">
                <Run x:Uid="HomeHeadingLead" />
                <Run x:Uid="HomeHeadingBrass" FontFamily="{StaticResource BcDisplayItalicFontFamily}" FontStyle="Italic"
                     Foreground="{ThemeResource BcBrassTextBrush}" />
            </TextBlock>
            <TextBlock x:Uid="HomeIntro" Style="{StaticResource LeadStyle}" Margin="0,-4,0,12" />

            <!-- The one primary: open a recording (or drop it here). -->
            <Border Style="{StaticResource CardStyle}" BorderBrush="{ThemeResource BcBorderStrongBrush}" Padding="24">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconWellStyle}" Width="56" Height="56">
                        <FontIcon Glyph="{StaticResource BcIconImportFile}" FontSize="20" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Uid="HomeDropTitle" Style="{StaticResource HeadlineStyle}" />
                        <TextBlock x:Uid="HomeDropFormats" Style="{StaticResource MutedStyle}" />
                    </StackPanel>
                    <Button x:Name="ImportButton" x:Uid="ImportButton" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.ImportCommand}" AccessKey="O" VerticalAlignment="Center">
                        <TextBlock x:Uid="ImportButtonLabel" />
                    </Button>
                </Grid>
            </Border>
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         x:Uid="DecodingProgress" Style="{StaticResource BrassProgressStyle}" />

            <!-- The other ways in, as cards. -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RecordMicButton" x:Uid="RecordMicButton" Style="{StaticResource CardButtonStyle}"
                        Command="{x:Bind ViewModel.RecordMicrophoneCommand}" AccessKey="M">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource IconWellStyle}" HorizontalAlignment="Left">
                            <FontIcon Glyph="{StaticResource BcIconRecordMic}" FontSize="16" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="RecordMicTitle" Style="{StaticResource HeadlineStyle}" />
                            <TextBlock x:Uid="RecordMicBody" Style="{StaticResource MutedStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button x:Name="RecordSystemButton" x:Uid="RecordSystemButton" Grid.Column="1" Style="{StaticResource CardButtonStyle}"
                        Command="{x:Bind ViewModel.RecordSystemAudioCommand}" AccessKey="Y">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource IconWellStyle}" HorizontalAlignment="Left">
                            <FontIcon Glyph="{StaticResource BcIconRecordDevice}" FontSize="16" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="RecordSystemTitle" Style="{StaticResource HeadlineStyle}" />
                            <TextBlock x:Uid="RecordSystemBody" Style="{StaticResource MutedStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <!-- One app only (Windows 11 process loopback): the app is picked in a flyout. -->
                <Button x:Name="RecordAppCard" x:Uid="RecordAppCard" Grid.Column="2" Style="{StaticResource CardButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.SupportsAppCapture}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom" Opened="OnAppFlyoutOpened">
                            <StackPanel Spacing="12" MinWidth="320">
                                <ComboBox x:Name="AppPicker" x:Uid="AppPicker" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.Apps}" SelectionChanged="OnAppSelected">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="capture:AudioApp">
                                            <TextBlock Text="{x:Bind Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button x:Uid="RefreshAppsButton" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.RefreshAppsCommand}">
                                        <FontIcon Glyph="{StaticResource BcIconRetry}" FontSize="16" />
                                    </Button>
                                    <Button x:Name="RecordAppButton" x:Uid="RecordAppButton" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{x:Bind ViewModel.RecordAppCommand}" AccessKey="A">
                                        <TextBlock x:Uid="RecordAppButtonLabel" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource IconWellStyle}" HorizontalAlignment="Left">
                            <FontIcon Glyph="{StaticResource BcIconChoose}" FontSize="16" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="RecordAppTitle" Style="{StaticResource HeadlineStyle}" />
                            <TextBlock Style="{StaticResource MutedStyle}" x:Uid="RecordAppBody"
                                       Visibility="{x:Bind ViewModel.SupportsAppCapture}" />
                            <TextBlock Style="{StaticResource MutedStyle}" x:Uid="AppCaptureUnavailable"
                                       Visibility="{x:Bind vm:Screens.Not(ViewModel.SupportsAppCapture)}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Recording: the time, a level meter with its value in words, and Stop. -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay}" Padding="20">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource NumericStyle}" FontSize="28" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.RecordingTime, Mode=OneWay}" x:Uid="RecordingTime" />
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <ProgressBar x:Name="LevelMeter" x:Uid="LevelMeter" Minimum="0" Maximum="1" Style="{StaticResource BrassProgressStyle}"
                                     Value="{x:Bind ViewModel.InputLevel, Mode=OneWay}"
                                     AutomationProperties.ItemStatus="{x:Bind ViewModel.InputLevelText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.InputLevelText, Mode=OneWay}" />
                    </StackPanel>
                    <Button x:Name="StopButton" x:Uid="StopRecordingButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.StopRecordingCommand}" AccessKey="T" />
                </Grid>
            </Border>

            <!-- Nothing heard, or something went wrong: said and shown, never silent. -->
            <InfoBar x:Uid="CaptureNotice" Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind vm:Screens.HasText(ViewModel.NoticeText), Mode=OneWay}"
                     Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}" />
            <InfoBar x:Uid="StartError" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind vm:Screens.HasText(ViewModel.ErrorText), Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="{StaticResource BcIconInfo}" FontSize="16" Foreground="{ThemeResource BcTextMutedBrush}" />
                <TextBlock x:Uid="LinkNote" Style="{StaticResource MutedStyle}" />
            </StackPanel>

            <!-- Your scores: the same list as the sidebar, as cards with what is still to check. -->
            <TextBlock x:Uid="HomeScoresHeading" Style="{StaticResource OverlineStyle}" Margin="0,24,0,0"
                       AutomationProperties.HeadingLevel="Level2" Visibility="{x:Bind Main.HasLibrary, Mode=OneWay}" />
            <GridView x:Name="ScoreCards" x:Uid="ScoreCards" ItemsSource="{x:Bind Main.LibraryItems}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="OnScoreCardClick" Visibility="{x:Bind Main.HasLibrary, Mode=OneWay}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItem">
                        <Border Style="{StaticResource CardStyle}" Width="264" Padding="16,14,8,14" AutomationProperties.Name="{x:Bind Title}"
                                AutomationProperties.HelpText="{x:Bind Subtitle}" ContextRequested="OnScoreCardContextRequested">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="{StaticResource BcIconComputer}" FontSize="14" Foreground="{ThemeResource BcTextMutedBrush}"
                                                  Visibility="{x:Bind OnComputer}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource HeadlineStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top"
                                        Tag="{x:Bind}" Click="OnScoreCardOptions" x:Uid="ScoreOptionsButton"
                                        AutomationProperties.HelpText="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Title}">
                                    <FontIcon Glyph="{StaticResource BcIconMore}" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <!-- Empty state: what will appear here, with the mark in brass. -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,24,0,0" Visibility="{x:Bind vm:Screens.Not(Main.HasLibrary), Mode=OneWay}">
                <Image Source="ms-appx:///Assets/Brand/mark-brass.svg" Width="28" Height="28" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Uid="HomeEmpty" Style="{StaticResource LeadStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Colour tokens from docs/accessibility/visual-design-tokens.md. In a Windows contrast theme the
    HighContrast dictionary maps every token to a system colour, so the user's palette wins and shape
    (ring, parentheses, outlines) carries the uncertainty level.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BcBackgroundColor">#FFFFFF</Color>
            <Color x:Key="BcSurfaceColor">#F4F4F2</Color>
            <Color x:Key="BcTextColor">#1A1A1A</Color>
            <Color x:Key="BcTextMutedColor">#595959</Color>
            <Color x:Key="BcInkColor">#000000</Color>
            <Color x:Key="BcStaffColor">#4D4D4D</Color>
            <Color x:Key="BcUncertainColor">#0063A6</Color>
            <Color x:Key="BcVeryUncertainColor">#B04A00</Color>
            <Color x:Key="BcAdLibTintColor">#EEF3F8</Color>
            <Color x:Key="BcLoopTintColor">#FFF3D6</Color>
            <Color x:Key="BcLoopEdgeColor">#8A5A00</Color>
            <Color x:Key="BcCursorColor">#6B3FA0</Color>
            <Color x:Key="BcFocusColor">#0050B3</Color>
            <Color x:Key="BcErrorColor">#B3261E</Color>
            <SolidColorBrush x:Key="BcBackgroundBrush" Color="{StaticResource BcBackgroundColor}" />
            <SolidColorBrush x:Key="BcSurfaceBrush" Color="{StaticResource BcSurfaceColor}" />
            <SolidColorBrush x:Key="BcTextBrush" Color="{StaticResource BcTextColor}" />
            <SolidColorBrush x:Key="BcTextMutedBrush" Color="{StaticResource BcTextMutedColor}" />
            <SolidColorBrush x:Key="BcInkBrush" Color="{StaticResource BcInkColor}" />
            <SolidColorBrush x:Key="BcUncertainBrush" Color="{StaticResource BcUncertainColor}" />
            <SolidColorBrush x:Key="BcVeryUncertainBrush" Color="{StaticResource BcVeryUncertainColor}" />
            <SolidColorBrush x:Key="BcAdLibTintBrush" Color="{StaticResource BcAdLibTintColor}" />
            <SolidColorBrush x:Key="BcLoopTintBrush" Color="{StaticResource BcLoopTintColor}" />
            <SolidColorBrush x:Key="BcLoopEdgeBrush" Color="{StaticResource BcLoopEdgeColor}" />
            <SolidColorBrush x:Key="BcCursorBrush" Color="{StaticResource BcCursorColor}" />
            <SolidColorBrush x:Key="BcFocusBrush" Color="{StaticResource BcFocusColor}" />
            <SolidColorBrush x:Key="BcErrorBrush" Color="{StaticResource BcErrorColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BcBackgroundColor">#121212</Color>
            <Color x:Key="BcSurfaceColor">#1E1E1E</Color>
            <Color x:Key="BcTextColor">#EDEDED</Color>
            <Color x:Key="BcTextMutedColor">#B3B3B3</Color>
            <Color x:Key="BcInkColor">#F2F2F2</Color>
            <Color x:Key="BcStaffColor">#A6A6A6</Color>
            <Color x:Key="BcUncertainColor">#56B4E9</Color>
            <Color x:Key="BcVeryUncertainColor">#F0A04B</Color>
            <Color x:Key="BcAdLibTintColor">#1B2530</Color>
            <Color x:Key="BcLoopTintColor">#33290F</Color>
            <Color x:Key="BcLoopEdgeColor">#E0B65C</Color>
            <Color x:Key="BcCursorColor">#C9A7F0</Color>
            <Color x:Key="BcFocusColor">#8AB4F8</Color>
            <Color x:Key="BcErrorColor">#F2B8B5</Color>
            <SolidColorBrush x:Key="BcBackgroundBrush" Color="{StaticResource BcBackgroundColor}" />
            <SolidColorBrush x:Key="BcSurfaceBrush" Color="{StaticResource BcSurfaceColor}" />
            <SolidColorBrush x:Key="BcTextBrush" Color="{StaticResource BcTextColor}" />
            <SolidColorBrush x:Key="BcTextMutedBrush" Color="{StaticResource BcTextMutedColor}" />
            <SolidColorBrush x:Key="BcInkBrush" Color="{StaticResource BcInkColor}" />
            <SolidColorBrush x:Key="BcUncertainBrush" Color="{StaticResource BcUncertainColor}" />
            <SolidColorBrush x:Key="BcVeryUncertainBrush" Color="{StaticResource BcVeryUncertainColor}" />
            <SolidColorBrush x:Key="BcAdLibTintBrush" Color="{StaticResource BcAdLibTintColor}" />
            <SolidColorBrush x:Key="BcLoopTintBrush" Color="{StaticResource BcLoopTintColor}" />
            <SolidColorBrush x:Key="BcLoopEdgeBrush" Color="{StaticResource BcLoopEdgeColor}" />
            <SolidColorBrush x:Key="BcCursorBrush" Color="{StaticResource BcCursorColor}" />
            <SolidColorBrush x:Key="BcFocusBrush" Color="{StaticResource BcFocusColor}" />
            <SolidColorBrush x:Key="BcErrorBrush" Color="{StaticResource BcErrorColor}" />
        </ResourceDictionary>
        <!-- Windows contrast themes (Aquatic, Desert, Dusk, Night sky): system colours only. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BcBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BcSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BcTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BcTextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BcInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BcUncertainBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="BcVeryUncertainBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="BcAdLibTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BcLoopTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BcLoopEdgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BcCursorBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BcFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BcErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

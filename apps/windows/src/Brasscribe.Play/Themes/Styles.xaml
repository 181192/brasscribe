<?xml version="1.0" encoding="utf-8"?>
<!--
    Brasscribe Play styles on top of the generated design tokens (Themes/BrasscribeTheme.xaml, linked
    from design/dist/windows). Colours come only from the Bc* brushes; in a Windows contrast theme
    those map to the user's system colours, and nothing here sets a colour of its own.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- The one primary button per screen is ink on light and paper on dark, never the system
             accent. The accent ramp is the ink ramp, so accent buttons, the dialog primary, checked
             toggles, check boxes and radio buttons all follow. Contrast themes keep the system's. -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#FF1B1A17</Color>
            <Color x:Key="SystemAccentColorDark1">#FF1B1A17</Color>
            <Color x:Key="SystemAccentColorDark2">#FF2B2824</Color>
            <Color x:Key="SystemAccentColorDark3">#FF3A3732</Color>
            <Color x:Key="SystemAccentColorLight1">#FF2B2824</Color>
            <Color x:Key="SystemAccentColorLight2">#FF3A3732</Color>
            <Color x:Key="SystemAccentColorLight3">#FF5E5A52</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#FFEDEBE6</Color>
            <Color x:Key="SystemAccentColorDark1">#FFD9D6CF</Color>
            <Color x:Key="SystemAccentColorDark2">#FFC4C0B8</Color>
            <Color x:Key="SystemAccentColorDark3">#FFB4B0A7</Color>
            <Color x:Key="SystemAccentColorLight1">#FFF2F0EB</Color>
            <Color x:Key="SystemAccentColorLight2">#FFEDEBE6</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFBFAF7</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>

    <!-- Music stand glyphs (Segoe Fluent Icons; design/music-stand.md §8) until design/tokens/icons.json has them. -->
    <x:String x:Key="BcIconMusicStand">&#xE740;</x:String>
    <x:String x:Key="BcIconPagePrevious">&#xE76B;</x:String>
    <x:String x:Key="BcIconPageNext">&#xE76C;</x:String>
    <x:String x:Key="BcIconMinus">&#xE738;</x:String>
    <x:String x:Key="BcIconPlus">&#xE710;</x:String>

    <!-- ===== Text ===== -->

    <!-- Screen titles in the display face (28 epx and up only). Landmarks for screen readers and focus targets. -->
    <Style x:Key="ScreenHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BcDisplayTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- The home and first-run greeting: the display face at its largest. -->
    <Style x:Key="HeroHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BcDisplayTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="LineHeight" Value="64" />
    </Style>

    <!-- The italic of the display face, in brass (the one brand moment of a heading). -->
    <FontFamily x:Key="BcDisplayItalicFontFamily">ms-appx:///Assets/Fonts/InstrumentSerif-Italic.ttf#Instrument Serif</FontFamily>

    <!-- Step and dialog titles below 28 epx are in the UI face. -->
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BcTitle2TextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style x:Key="HeadlineStyle" TargetType="TextBlock" BasedOn="{StaticResource BcHeadlineTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
    </Style>

    <!-- Small capitals above a title: "STEP 4 OF 6 · SOLOIST WITH ORCHESTRA OR BAND", "YOUR SCORES". -->
    <Style x:Key="OverlineStyle" TargetType="TextBlock" BasedOn="{StaticResource BcCaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextMutedBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <Style x:Key="BodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BcBodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
    </Style>

    <Style x:Key="LeadStyle" TargetType="TextBlock" BasedOn="{StaticResource BcBodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextMutedBrush}" />
    </Style>

    <Style x:Key="MutedStyle" TargetType="TextBlock" BasedOn="{StaticResource BcCalloutTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextMutedBrush}" />
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BcLabelTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
    </Style>

    <Style x:Key="NumericStyle" TargetType="TextBlock" BasedOn="{StaticResource BcNumericTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
    </Style>

    <!-- Errors keep the text in ink; only the icon carries the error colour. -->
    <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BcLabelTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
    </Style>

    <!-- ===== Buttons: 12 epx corners everywhere, one primary per screen ===== -->

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusMd}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
    </Style>

    <!-- Tonal: the second-most-likely action. -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{ThemeResource BcSecondaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BcOnSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusMd}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    </Style>

    <!-- Outline: actions in dialogs and toolbars. -->
    <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BcBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusMd}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    </Style>

    <!-- Plain: Cancel and Skip. -->
    <!-- A part's source label: neutral chrome, never a colour. An outline pill with an icon and words that opens one
         sentence of explanation; the same words on every screen and platform. -->
    <Style x:Key="SourcePillStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource BcBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="PlainButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusMd}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
    </Style>

    <!-- Icon-only buttons of the title bar and the transport row (each has a name matching its tooltip). -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusSm}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
    </Style>

    <!-- The round Play button: the primary of the player. -->
    <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    </Style>

    <!-- Player chips (Count-in, Metronome, Mute my part): 48 epx, outline when off, tonal + check when on. -->
    <Style x:Key="TransportToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource BcBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusMd}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- On = tonal fill, a 1.5 epx ink edge and a check before the label; off = an outline.
                     Ink fill is kept for the one primary (design/system.md §1). -->
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon x:Name="Check" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource BcTextBrush}" Visibility="Collapsed" />
                            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{ThemeResource BcTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource BcSurfaceBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource BcSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource BcSecondaryBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource BcTextBrush}" />
                                        <Setter Target="Chip.BorderThickness" Value="1.5" />
                                        <Setter Target="Check.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource BcSecondaryBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource BcTextBrush}" />
                                        <Setter Target="Chip.BorderThickness" Value="1.5" />
                                        <Setter Target="Check.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource BcSurfaceBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource BcTextBrush}" />
                                        <Setter Target="Chip.BorderThickness" Value="1.5" />
                                        <Setter Target="Check.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Opacity" Value="0.5" />
                                        <Setter Target="Check.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segments (Written/Concert pitch, Score/Original, what to export): warm greys, no colour. -->
    <Style x:Key="SegmentToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusSm}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
    </Style>

    <!-- A segment that is one of a group (RadioButton with GroupName): the chosen one is raised with an outline. -->
    <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Segment" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{StaticResource BcRadiusSm}" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{ThemeResource BcTextMutedBrush}" FontWeight="SemiBold" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource BcTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Segment.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Segment.Background" Value="{ThemeResource BcSurfaceRaisedBrush}" />
                                        <Setter Target="Segment.BorderBrush" Value="{ThemeResource BcBorderStrongBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource BcTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BcSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusMd}" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- Mute / Only this of a part: labelled, 36 epx (40 on touch), tonal + check when on. -->
    <Style x:Key="MixerToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource BcBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusSm}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- On = tonal fill, a 1.5 epx ink edge and a check before the label; off = an outline.
                     Ink fill is kept for the one primary (design/system.md §1). -->
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon x:Name="Check" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource BcTextBrush}" Visibility="Collapsed" />
                            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{ThemeResource BcTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource BcSurfaceBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource BcSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource BcSecondaryBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource BcTextBrush}" />
                                        <Setter Target="Chip.BorderThickness" Value="1.5" />
                                        <Setter Target="Check.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource BcSecondaryBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource BcTextBrush}" />
                                        <Setter Target="Chip.BorderThickness" Value="1.5" />
                                        <Setter Target="Check.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource BcSurfaceBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource BcTextBrush}" />
                                        <Setter Target="Chip.BorderThickness" Value="1.5" />
                                        <Setter Target="Check.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Opacity" Value="0.5" />
                                        <Setter Target="Check.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Surfaces ===== -->

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BcSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusLg}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- The connection status row (Home, Settings): surface fill, 1 px border, 12 px corners, as on Apple and Android. -->
    <Style x:Key="StatusRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BcSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusMd}" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!-- The 40 epx icon well of list rows and cards. -->
    <Style x:Key="IconWellStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{ThemeResource BcSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusSm}" />
    </Style>

    <!-- A card-sized action (Record with the microphone, Record what's playing, Open a score). -->
    <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="Background" Value="{ThemeResource BcSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BcRadiusLg}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
    </Style>

    <!-- "What is this?" answers: a card with the radio at the right, a 2 epx ink ring when chosen. -->
    <Style x:Key="ChoiceCardStyle" TargetType="RadioButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="112" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="Foreground" Value="{ThemeResource BcTextBrush}" />
        <Setter Property="Background" Value="{ThemeResource BcSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BcBorderStrongBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource BcFocusBrush}" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="1" CornerRadius="{StaticResource BcRadiusLg}" Padding="{TemplateBinding Padding}" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}" VerticalAlignment="Top" />
                        <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Top" Margin="0,4,0,0">
                            <Ellipse x:Name="Outer" Stroke="{ThemeResource BcBorderStrongBrush}" StrokeThickness="2" />
                            <Ellipse x:Name="Filled" Fill="{ThemeResource BcPrimaryBrush}" Opacity="0" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{ThemeResource BcOnPrimaryBrush}" Opacity="0" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Card.Background" Value="{ThemeResource BcSurfaceBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Card.Background" Value="{ThemeResource BcSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Card.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Card.BorderBrush" Value="{ThemeResource BcPrimaryBrush}" />
                                        <Setter Target="Card.BorderThickness" Value="2" />
                                        <Setter Target="Filled.Opacity" Value="1" />
                                        <Setter Target="Dot.Opacity" Value="1" />
                                        <Setter Target="Outer.Stroke" Value="{ThemeResource BcPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The progress bar is the one working brand moment: brass fill. -->
    <Style x:Key="BrassProgressStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource BcBrassBrush}" />
        <Setter Property="Background" Value="{ThemeResource BcBorderBrush}" />
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- The icon glyph font: Segoe Fluent Icons, falling back to Segoe MDL2 Assets on older Windows. -->
    <Style x:Key="BcFontIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Brasscribe.Play.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Brasscribe.Play.Views"
    xmlns:vm="using:Brasscribe.Play.Core.ViewModels">

    <Grid x:Name="Root" Background="{ThemeResource BcBackgroundBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <!-- Global shortcuts (qa/screen-reader-scripts/keyboard-desktop.md); all use a modifier. -->
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnImportAccelerator" />
            <KeyboardAccelerator Key="R" Modifiers="Control,Shift" Invoked="OnRecordAccelerator" />
            <KeyboardAccelerator Key="Space" Modifiers="Control,Shift" Invoked="OnPlayPauseAccelerator" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnExportAccelerator" />
            <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnGoToBarAccelerator" />
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnToggleTalkingScoreAccelerator" />
            <KeyboardAccelerator Key="F1" Invoked="OnShortcutsAccelerator" />
            <KeyboardAccelerator Key="GoBack" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: back, title, actions. Tab order follows reading order. -->
        <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource BcSurfaceBrush}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" x:Uid="BackButton" Grid.Column="0" Style="{StaticResource ActionButtonStyle}"
                    Command="{x:Bind ViewModel.BackCommand}" AccessKey="B">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <TextBlock x:Name="AppTitle" x:Uid="AppTitle" Grid.Column="1" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource BcTextBrush}" />
            <Button x:Name="ExportButton" x:Uid="ExportButton" Grid.Column="2" Style="{StaticResource ActionButtonStyle}"
                    Click="OnExportClick" AccessKey="E" IsEnabled="{x:Bind vm:Screens.IsScore(ViewModel.Screen), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEDE1;" />
                    <TextBlock x:Uid="ExportButtonLabel" />
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" x:Uid="SettingsButton" Grid.Column="3" Style="{StaticResource ActionButtonStyle}"
                    Click="OnSettingsClick" AccessKey="S">
                <FontIcon Glyph="&#xE713;" />
            </Button>
            <Button x:Name="HelpButton" x:Uid="HelpButton" Grid.Column="4" Style="{StaticResource ActionButtonStyle}"
                    Click="OnShortcutsClick" AccessKey="H">
                <FontIcon Glyph="&#xE897;" />
            </Button>
        </Grid>

        <!-- One screen at a time; each screen puts focus on its heading when shown. -->
        <Grid Grid.Row="1">
            <views:StartView x:Name="StartScreen" ViewModel="{x:Bind ViewModel.Start}"
                             Visibility="{x:Bind vm:Screens.IsStart(ViewModel.Screen), Mode=OneWay}" />
            <views:SourceKindView x:Name="SourceKindScreen" ViewModel="{x:Bind ViewModel.Kind}"
                                  Visibility="{x:Bind vm:Screens.IsSourceKind(ViewModel.Screen), Mode=OneWay}" />
            <views:TranscriptionView x:Name="TranscriptionScreen" ViewModel="{x:Bind ViewModel.Transcription}"
                                     Visibility="{x:Bind vm:Screens.IsTranscribing(ViewModel.Screen), Mode=OneWay}" />
            <views:ScoreScreen x:Name="ScoreScreenView" ViewModel="{x:Bind ViewModel.Score}" Output="{x:Bind ViewModel.Output}"
                               Visibility="{x:Bind vm:Screens.IsScore(ViewModel.Screen), Mode=OneWay}" />
        </Grid>

        <!-- Status bar. The announcer raises UIA notifications from this element; it is not a live region itself. -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Padding="12,4" Style="{StaticResource MutedStyle}"
                   Text="{x:Bind ViewModel.Score.Player.PositionText, Mode=OneWay}" />
    </Grid>
</Window>

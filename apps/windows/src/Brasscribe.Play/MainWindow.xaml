<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Brasscribe.Play.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Brasscribe.Play.Core.ViewModels">

    <Grid x:Name="Root" Background="{ThemeResource BcBgBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <!-- Global shortcuts (qa/screen-reader-scripts/keyboard-desktop.md); all use a modifier. -->
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnImportAccelerator" />
            <KeyboardAccelerator Key="R" Modifiers="Control,Shift" Invoked="OnRecordAccelerator" />
            <KeyboardAccelerator Key="Space" Modifiers="Control,Shift" Invoked="OnPlayPauseAccelerator" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnExportAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnExportAccelerator" />
            <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnGoToBarAccelerator" />
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnToggleTalkingScoreAccelerator" />
            <KeyboardAccelerator Key="F1" Invoked="OnShortcutsAccelerator" />
            <KeyboardAccelerator Key="GoBack" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: back, the page title and its subtitle, then the page's actions. The window's
             own caption buttons sit to the right (ExtendsContentIntoTitleBar). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="52" Padding="12,0,140,0" ColumnSpacing="12"
              Background="{ThemeResource BcBgBrush}" BorderBrush="{ThemeResource BcBorderBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" x:Uid="BackButton" Grid.Column="0" Style="{StaticResource PlainButtonStyle}" MinHeight="40"
                    Padding="10,6" Command="{x:Bind ViewModel.BackCommand}" AccessKey="B">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{StaticResource BcIconBack}" FontSize="14" />
                    <TextBlock x:Name="BackLabel" Style="{StaticResource LabelStyle}" />
                </StackPanel>
            </Button>
            <!-- The drag region is only the empty middle, so the buttons keep their clicks. -->
            <Border x:Name="DragRegion" Grid.Column="1" Grid.ColumnSpan="2" Background="Transparent" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="PageTitle" Style="{StaticResource LabelStyle}" FontSize="15" VerticalAlignment="Center" />
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="ExportButton" x:Uid="ExportButton" Grid.Column="3" Style="{StaticResource ActionButtonStyle}"
                    Click="OnExportClick" AccessKey="E" Visibility="{x:Bind vm:Screens.IsScore(ViewModel.Screen), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{StaticResource BcIconExport}" FontSize="16" />
                    <TextBlock x:Uid="ExportButtonLabel" Style="{StaticResource LabelStyle}" />
                </StackPanel>
            </Button>
            <Button x:Name="HelpButton" x:Uid="HelpButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                    Click="OnShortcutsClick" AccessKey="H">
                <FontIcon Glyph="{StaticResource BcIconHelp}" FontSize="16" />
            </Button>
            <Button x:Name="SettingsButton" x:Uid="SettingsButton" Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                    Click="OnSettingsClick" AccessKey="S">
                <FontIcon Glyph="{StaticResource BcIconSettings}" FontSize="16" />
            </Button>
        </Grid>

        <!-- The library pane (Home and while a score is made) and the flow steps in a Frame. -->
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="280" CompactModeThresholdWidth="1008"
                        IsPaneVisible="{x:Bind vm:Screens.ShowsLibrary(ViewModel.Screen), Mode=OneWay}"
                        MenuItemsSource="{x:Bind ViewModel.LibraryItems}" ItemInvoked="OnLibraryItemInvoked"
                        x:Uid="LibraryNav">
            <NavigationView.Resources>
                <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="BcSurfaceBrush" />
                <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="BcSurfaceBrush" />
                <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="BcBgBrush" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <StackPanel Padding="12,16,12,4" Spacing="16">
                    <!-- Lockup: the mark in brass and "Brasscribe Play" with the product name in the brass italic. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,0,0,0" AutomationProperties.Name="Brasscribe Play">
                        <Image Source="ms-appx:///Assets/Brand/mark-brass.svg" Width="22" Height="22" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock FontFamily="{StaticResource BcDisplayFontFamily}" FontSize="22" Foreground="{ThemeResource BcTextBrush}"
                                   AutomationProperties.AccessibilityView="Raw">
                            <Run Text="Brasscribe" />
                            <Run Text="Play" FontFamily="{StaticResource BcDisplayItalicFontFamily}" FontStyle="Italic" Foreground="{ThemeResource BcBrassTextBrush}" />
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="NewScoreButton" x:Uid="NewScoreButton" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Background="{ThemeResource BcSurfaceRaisedBrush}" BorderBrush="{ThemeResource BcBorderBrush}"
                            Command="{x:Bind ViewModel.NewScoreCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="{StaticResource BcIconImportFile}" FontSize="16" />
                            <TextBlock x:Uid="NewScoreLabel" Style="{StaticResource LabelStyle}" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Uid="LibraryHeading" Style="{StaticResource OverlineStyle}" Margin="12,8,0,0"
                               AutomationProperties.HeadingLevel="Level2" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:LibraryItem">
                    <NavigationViewItem AutomationProperties.Name="{x:Bind Title}" AutomationProperties.HelpText="{x:Bind Subtitle}"
                                        ToolTipService.ToolTip="{x:Bind Subtitle}" ContextRequested="OnLibraryItemContextRequested">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind vm:Screens.LibraryGlyph(OnComputer)}" />
                        </NavigationViewItem.Icon>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Padding="0"
                                    Tag="{x:Bind}" Click="OnLibraryItemOptions" x:Uid="ScoreOptionsButton"
                                    AutomationProperties.HelpText="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Title}">
                                <FontIcon Glyph="{StaticResource BcIconMore}" FontSize="14" />
                            </Button>
                        </Grid>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />
        </NavigationView>

        <!-- Status line. The announcer raises UIA notifications from this element; it is not a live region itself. -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Padding="16,2" Style="{StaticResource MutedStyle}" FontSize="12"
                   Text="{x:Bind ViewModel.Score.Player.PositionText, Mode=OneWay}" />
    </Grid>
</Window>

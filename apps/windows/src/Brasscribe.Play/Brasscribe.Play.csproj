<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Brasscribe Play for Windows: WinUI 3 (Windows App SDK), unpackaged and self-contained so CI can
    start the exe directly for the accessibility scan. Package.appxmanifest is kept for an MSIX build
    (set WindowsPackageType to MSIX).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(BrasscribeWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(BrasscribeWindowsMinVersion)</TargetPlatformMinVersion>
    <RootNamespace>Brasscribe.Play</RootNamespace>
    <AssemblyName>BrasscribePlay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\..\..\design\dist\icons\windows\Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>en-US;nb-NO</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- DirectML build of ONNX Runtime; never together with the CPU package (both ship onnxruntime.dll). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <!-- Native Skia for alphaTab's bitmap rendering. -->
    <PackageReference Include="AlphaSkia.Native.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brasscribe.Play.Core\Brasscribe.Play.Core.csproj" />
    <ProjectReference Include="..\Brasscribe.Play.Audio.Windows\Brasscribe.Play.Audio.Windows.csproj" />
    <ProjectReference Include="..\Brasscribe.Play.Controls\Brasscribe.Play.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The design system (design/): theme, display face and app icons are linked from design/dist,
       never copied, so a token change reaches the app on the next build. -->
  <PropertyGroup>
    <DesignDir>..\..\..\..\design\</DesignDir>
  </PropertyGroup>
  <ItemGroup>
    <Page Include="$(DesignDir)dist\windows\BrasscribeTheme.xaml" Link="Themes\BrasscribeTheme.xaml" />
    <!-- The hidden Pink palette: merged in by Services/ThemeController while Pink is chosen. -->
    <Page Include="$(DesignDir)dist\windows\BrasscribePinkTheme.xaml" Link="Themes\BrasscribePinkTheme.xaml" />
    <Content Include="$(DesignDir)dist\windows\Assets\Fonts\*" Link="Assets\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The brass italic of the display face ("a score.") is its own font file, not a slanted Regular. -->
    <Content Include="$(DesignDir)brand\fonts\InstrumentSerif-Italic.ttf" Link="Assets\Fonts\InstrumentSerif-Italic.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(DesignDir)dist\icons\windows\Assets\*" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(DesignDir)brand\logo\mark-brass.svg" Link="Assets\Brand\mark-brass.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sounds and models are copied next to the exe when present (never committed). The band
         SoundFont (16-bit build) with its part map is the default; the per-instrument SoundFonts are the fallback. -->
    <Content Include="..\..\..\..\data\sounds\band\brasscribe-band-16bit.sf2" Link="SoundFonts\brasscribe-band.sf2"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\..\data\sounds\band\brasscribe-band-16bit.sf2')" />
    <Content Include="..\..\..\..\sounds\mapping.json" Link="SoundFonts\mapping.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\data\sounds\built\**\*.sf2" Link="SoundFonts\built\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\..\data\sounds\built') And !Exists('..\..\..\..\data\sounds\band\brasscribe-band-16bit.sf2')" />
    <Content Include="..\..\..\..\models\converted\swift-f0\*.onnx" Link="Models\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\..\models\converted\swift-f0')" />
  </ItemGroup>

  <!-- The Rust core (brasscribe_ffi.dll) goes next to the exe, where NativeCoreBridge loads it; without
       it the app runs on the managed fallback. Pass -p:BrasscribeFfiDll=path to pick a build, otherwise
       the first of: cargo's MSVC host build, the explicit MSVC target build, core/dist/windows. -->
  <PropertyGroup>
    <CoreDir>$(MSBuildThisFileDirectory)..\..\..\..\core\</CoreDir>
    <BrasscribeFfiDll Condition="'$(BrasscribeFfiDll)' == '' And Exists('$(CoreDir)target\release\brasscribe_ffi.dll')">$(CoreDir)target\release\brasscribe_ffi.dll</BrasscribeFfiDll>
    <BrasscribeFfiDll Condition="'$(BrasscribeFfiDll)' == '' And Exists('$(CoreDir)target\x86_64-pc-windows-msvc\release\brasscribe_ffi.dll')">$(CoreDir)target\x86_64-pc-windows-msvc\release\brasscribe_ffi.dll</BrasscribeFfiDll>
    <BrasscribeFfiDll Condition="'$(BrasscribeFfiDll)' == '' And Exists('$(CoreDir)dist\windows\brasscribe_ffi.dll')">$(CoreDir)dist\windows\brasscribe_ffi.dll</BrasscribeFfiDll>
  </PropertyGroup>
  <ItemGroup Condition="'$(BrasscribeFfiDll)' != '' And Exists('$(BrasscribeFfiDll)')">
    <Content Include="$(BrasscribeFfiDll)" Link="brasscribe_ffi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

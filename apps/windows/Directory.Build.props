<Project>
  <PropertyGroup>
    <!-- The app version, bumped with the others by scripts/release.sh. -->
    <Version>0.4.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>brasscribe</Authors>
    <Product>Brasscribe Play</Product>
    <Company>brasscribe</Company>
    <Copyright>Copyright (c) 2026 Kristoffer-Andre Kalliainen</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <!-- Lets the Windows-only projects compile against reference assemblies on macOS and Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Windows target. Per-app loopback additionally checks for OS build 20348 at run time. -->
    <BrasscribeWindowsTfm>net10.0-windows10.0.20348.0</BrasscribeWindowsTfm>
    <BrasscribeWindowsMinVersion>10.0.19041.0</BrasscribeWindowsMinVersion>
  </PropertyGroup>
</Project>

<Project>
  <PropertyGroup>
    <!-- The app version, bumped with the others by scripts/release.sh. -->
    <Version>0.14.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>brasscribe</Authors>
    <Company>brasscribe</Company>
    <Copyright>Copyright (c) 2026 Kristoffer-Andre Kalliainen</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <!-- Lets the Windows-only projects compile against reference assemblies on macOS and Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Windows target: Windows 11 (build 22000) is the oldest system the app runs on. -->
    <ScribeWindowsTfm>net10.0-windows10.0.22000.0</ScribeWindowsTfm>
    <ScribeWindowsMinVersion>10.0.22000.0</ScribeWindowsMinVersion>
  </PropertyGroup>
  <!-- The screen catalogue (products/brasscribe/Kalli.Brasscribe.Catalogue) is the app built with -p:ScribeCatalogue=true: it
       builds into bin/catalogue and obj/catalogue, so it never mixes with the app's own build, and leaves the app's
       build folders out of its sources. -->
  <PropertyGroup Condition="'$(ScribeCatalogue)' == 'true'">
    <BaseIntermediateOutputPath>obj\catalogue\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\catalogue\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Code-only WinUI 3 controls (no .xaml files): the notation view and its UI Automation peers.
    Kept separate from the app so the peers are type-checked without the XAML compiler.
  -->
  <PropertyGroup>
    <TargetFramework>$(ScribeWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(ScribeWindowsMinVersion)</TargetPlatformMinVersion>
    <RootNamespace>Kalli.Scribe.Controls</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64;AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kalli.Scribe.Play\Kalli.Scribe.Play.csproj" />
  </ItemGroup>
</Project>

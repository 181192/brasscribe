<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Type-checks Fretscribe's C# (code-behind, services, composition root) without the WinUI XAML compiler, which only
    runs on Windows: ../gen_stubs.py writes the members the XAML compiler would generate. The real app build (XAML,
    x:Bind, PRI, packaging) happens on Windows CI.
  -->
  <PropertyGroup>
    <TargetFramework>$(ScribeWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(ScribeWindowsMinVersion)</TargetPlatformMinVersion>
    <OutputType>Library</OutputType>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Kalli.Fretscribe</RootNamespace>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppDir>$(MSBuildThisFileDirectory)../../../products/fretscribe/Kalli.Fretscribe</AppDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(AppDir)/**/*.cs" Exclude="$(AppDir)/obj/**;$(AppDir)/bin/**" />
    <Compile Include="$(IntermediateOutputPath)stubs/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../services/Kalli.Scribe.Services/Kalli.Scribe.Services.csproj" />
    <ProjectReference Include="../../../services/Kalli.Scribe.Audio.Windows/Kalli.Scribe.Audio.Windows.csproj" />
    <ProjectReference Include="../../../services/Kalli.Scribe.WinUI/Kalli.Scribe.WinUI.csproj" />
    <ProjectReference Include="../../../features/Kalli.Scribe.Score/Kalli.Scribe.Score.csproj" />
    <ProjectReference Include="../../../features/Kalli.Scribe.Play/Kalli.Scribe.Play.csproj" />
    <ProjectReference Include="../../../features/Kalli.Scribe.Tab/Kalli.Scribe.Tab.csproj" />
    <ProjectReference Include="../../../features/Kalli.Scribe.Controls/Kalli.Scribe.Controls.csproj" />
  </ItemGroup>
  <!-- With -p:ScribeCatalogue=true: the app as the screen catalogue's test host (products/fretscribe/Kalli.Fretscribe.Catalogue). -->
  <PropertyGroup Condition="'$(ScribeCatalogue)' == 'true'">
    <DefineConstants>$(DefineConstants);SCRIBE_CATALOGUE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ScribeCatalogue)' == 'true'">
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <Compile Include="$(AppDir)/../Kalli.Fretscribe.Catalogue/**/*.cs" />
    <ProjectReference Include="../../ScreenCheck.Core/ScreenCheck.Core.csproj" />
  </ItemGroup>
  <Target Name="GenerateXamlStubs" BeforeTargets="CoreCompile;BeforeBuild">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../gen_stubs.py&quot; &quot;$(AppDir)&quot; &quot;$(IntermediateOutputPath)stubs&quot;" />
    <ItemGroup>
      <Compile Remove="$(IntermediateOutputPath)stubs/*.cs" />
      <Compile Include="$(IntermediateOutputPath)stubs/*.cs" />
    </ItemGroup>
  </Target>
</Project>

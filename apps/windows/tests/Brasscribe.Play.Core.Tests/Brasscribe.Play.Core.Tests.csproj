<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- CPU native build of ONNX Runtime (win, linux, osx-arm64). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <!-- alphaTab measures text through AlphaSkia even for SVG output. -->
    <PackageReference Include="AlphaSkia.Native.Windows" />
    <PackageReference Include="AlphaSkia.Native.MacOs" />
    <PackageReference Include="AlphaSkia.Native.Linux" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Brasscribe.Play.Core/Brasscribe.Play.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The talking-score conformance vectors, read from docs/ like every other port. -->
    <None Include="../../../../docs/accessibility/talking-score-vectors.json" Link="Fixtures/talking-score-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows audio: WASAPI capture (microphone, system loopback, per-app process loopback), Media Foundation decoding, WASAPI output. -->
  <PropertyGroup>
    <TargetFramework>$(ScribeWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ScribeWindowsMinVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Kalli.Scribe.Audio.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kalli.Scribe.Services\Kalli.Scribe.Services.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral logic of Brasscribe Play: builds and tests on macOS, Linux and Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Brasscribe.Play.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="AlphaTab" />
    <!-- Managed ONNX Runtime API only. The host picks the native build: CPU in tests, DirectML in the app. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Brasscribe.Play.Core.Tests" />
  </ItemGroup>
</Project>

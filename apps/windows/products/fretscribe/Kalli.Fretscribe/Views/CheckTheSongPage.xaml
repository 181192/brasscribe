<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kalli.Fretscribe.Views.CheckTheSongPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tab="using:Kalli.Scribe.Tab"
    NavigationCacheMode="Required">

    <!-- Check the song: what Fretscribe heard, one row per finding, each with the change it offers; then Show the tab.
         A change writes the same recording down again with that one thing different. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Padding="40,56,40,32" Spacing="12" HorizontalAlignment="Center" MinWidth="520">
            <TextBlock x:Name="Heading" x:Uid="CheckHeading" Style="{StaticResource ScreenHeadingStyle}"
                       AutomationProperties.HeadingLevel="Level1" IsTabStop="True" />
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsReading, Mode=OneWay}">
                <TextBlock x:Uid="CheckReading" Style="{StaticResource LeadStyle}" />
                <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressStyle}" x:Uid="CheckReadingProgress" />
            </StackPanel>
            <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.HasMissing, Mode=OneWay}"
                     Message="{x:Bind ViewModel.MissingText, Mode=OneWay}" />
            <TextBlock x:Uid="CheckLead" Style="{StaticResource LeadStyle}" TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.ShowsLead, Mode=OneWay}" />
            <!-- Above the rows, so it is seen: why the buttons are not there. -->
            <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.HasNoChange, Mode=OneWay}"
                     Message="{x:Bind ViewModel.NoChangeText, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="tab:SongCheckRow">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="20,14">
                            <StackPanel Spacing="8">
                                <!-- The finding's name and what was heard, read as one. -->
                                <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}" IsTabStop="False">
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource MutedStyle}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{x:Bind Shown}" Style="{StaticResource HeadlineStyle}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{x:Bind Caption}" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"
                                               Visibility="{x:Bind HasCaption}" AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                                <Button Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" MinHeight="40"
                                        Content="{x:Bind Change.Label}" Tag="{x:Bind}" Click="OnChange" Visibility="{x:Bind HasChange}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnSpacing="16" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="CheckLater" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.ShowsLater, Mode=OneWay}" />
                <Button x:Name="ShowTabButton" x:Uid="ShowTabButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{x:Bind ViewModel.ShowCommand}" AccessKey="T" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

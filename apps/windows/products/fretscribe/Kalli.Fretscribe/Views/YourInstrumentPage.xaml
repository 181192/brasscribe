<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kalli.Fretscribe.Views.YourInstrumentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Kalli.Fretscribe.Views">

    <!-- Your instrument: one question per row, all on one screen. Nothing is kept until Save; Not now keeps what is
         stored (a six-string guitar in standard tuning before anything is). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Padding="40,48,40,32" Spacing="20" HorizontalAlignment="Center" MinWidth="480">
            <TextBlock x:Name="Heading" x:Uid="InstrumentHeading" Style="{StaticResource ScreenHeadingStyle}"
                       AutomationProperties.HeadingLevel="Level1" IsTabStop="True" />
            <TextBlock x:Uid="InstrumentLead" Style="{StaticResource LeadStyle}" TextWrapping="Wrap" />

            <ComboBox x:Name="InstrumentBox" x:Uid="InstrumentBox" HorizontalAlignment="Stretch" SelectionChanged="OnInstrumentChanged" />
            <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch" SelectionChanged="OnKindChanged"
                      Header="{x:Bind ViewModel.KindLabel, Mode=OneWay}"
                      Visibility="{x:Bind views:Shown.If(ViewModel.HasKinds), Mode=OneWay}" />
            <ComboBox x:Name="TuningBox" x:Uid="TuningBox" HorizontalAlignment="Stretch" SelectionChanged="OnTuningChanged" />
            <StackPanel Spacing="6">
                <ComboBox x:Name="HandBox" x:Uid="HandBox" HorizontalAlignment="Stretch" SelectionChanged="OnHandChanged" />
                <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.HandNote}" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox x:Name="ReadsBox" x:Uid="ReadsBox" HorizontalAlignment="Stretch" SelectionChanged="OnReadsChanged" />

            <Grid ColumnSpacing="12" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="NotNowButton" x:Uid="InstrumentNotNowButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind ViewModel.NotNowCommand}" />
                <Button x:Name="SaveButton" x:Uid="InstrumentSaveButton" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

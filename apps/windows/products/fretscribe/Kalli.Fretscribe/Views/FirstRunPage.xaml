<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kalli.Fretscribe.Views.FirstRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <!-- First run: one screen, three points, [Get started]. No account; permissions are asked when first needed. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Padding="40,56,40,32" Spacing="28" HorizontalAlignment="Center">
            <Image x:Name="Mark" Width="56" Height="56" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="Heading" x:Uid="FirstRunHeading" Style="{StaticResource HeroHeadingStyle}" AutomationProperties.HeadingLevel="Level1"
                       IsTabStop="True" />
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconWellStyle}" Width="48" Height="48" VerticalAlignment="Top">
                    <FontIcon Glyph="{StaticResource FsIconRecordMic}" FontSize="20" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Uid="FirstRunPoint1Title" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="FirstRunPoint1Body" Style="{StaticResource LeadStyle}" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconWellStyle}" Width="48" Height="48" VerticalAlignment="Top">
                    <FontIcon Glyph="{StaticResource FsIconComputer}" FontSize="20" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Uid="FirstRunPoint2Title" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="FirstRunPoint2Body" Style="{StaticResource LeadStyle}" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- The "?" is taught here: a note Fretscribe is not sure of. -->
                <Border Style="{StaticResource IconWellStyle}" Width="48" Height="48" VerticalAlignment="Top">
                    <TextBlock Text="?" FontWeight="Bold" FontSize="18" Foreground="{ThemeResource ScribeUncertainBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Uid="FirstRunPoint3Title" Style="{StaticResource HeadlineStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="FirstRunPoint3Body" Style="{StaticResource LeadStyle}" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{StaticResource FsIconInfo}" FontSize="16" Foreground="{ThemeResource ScribeTextMutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Grid.Column="1" x:Uid="FirstRunPrivacy" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                </Grid>
                <Button x:Name="GetStartedButton" x:Uid="GetStartedButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{x:Bind ViewModel.GetStartedCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

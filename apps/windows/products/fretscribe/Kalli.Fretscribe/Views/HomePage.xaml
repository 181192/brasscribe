<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kalli.Fretscribe.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kalli.Scribe.ViewModels"
    xmlns:views="using:Kalli.Fretscribe.Views"
    NavigationCacheMode="Required"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Padding="40,40,40,32" Spacing="16" HorizontalAlignment="Center">
            <TextBlock x:Name="Heading" x:Uid="HomeHeading" Style="{StaticResource HeroHeadingStyle}" AutomationProperties.HeadingLevel="Level1"
                       IsTabStop="True" />
            <TextBlock x:Uid="HomeIntro" Style="{StaticResource LeadStyle}" Margin="0,-4,0,4" TextWrapping="Wrap" />

            <!-- Bandroom on your computer: connected, looking, not connected or pair again. -->
            <views:ConnectionRow x:Name="ConnectionStatus" Margin="0,0,0,8" ActionInvoked="OnConnectionAction" />

            <!-- The one primary: record, one click from opening the app. -->
            <Border Style="{StaticResource CardStyle}" BorderBrush="{ThemeResource ScribeBorderStrongBrush}" Padding="24">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconWellStyle}" Width="56" Height="56">
                        <FontIcon Glyph="{StaticResource FsIconRecordMic}" FontSize="20" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Uid="RecordMicTitle" Style="{StaticResource HeadlineStyle}" />
                        <TextBlock x:Uid="RecordMicBody" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="RecordMicButton" x:Uid="RecordMicButton" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.RecordMicrophoneCommand}" AccessKey="M" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         x:Uid="DecodingProgress" Style="{StaticResource ProgressStyle}" />

            <!-- Recording: the time, a level meter with its value in words, and Stop. -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay}" Padding="20">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource NumericStyle}" FontSize="28" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.RecordingTime, Mode=OneWay}" x:Uid="RecordingTime" />
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <ProgressBar x:Name="LevelMeter" x:Uid="LevelMeter" Minimum="0" Maximum="1" Style="{StaticResource ProgressStyle}"
                                     Value="{x:Bind ViewModel.InputLevel, Mode=OneWay}"
                                     AutomationProperties.ItemStatus="{x:Bind ViewModel.InputLevelText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.InputLevelText, Mode=OneWay}" />
                    </StackPanel>
                    <Button x:Name="StopButton" x:Uid="StopRecordingButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.StopRecordingCommand}" AccessKey="T" />
                </Grid>
            </Border>

            <!-- The other ways in. -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ImportButton" x:Uid="ImportButton" Style="{StaticResource CardButtonStyle}"
                        Command="{x:Bind ViewModel.ImportCommand}" AccessKey="O">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource IconWellStyle}" HorizontalAlignment="Left">
                            <FontIcon Glyph="{StaticResource FsIconImportFile}" FontSize="16" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="ImportTitle" Style="{StaticResource HeadlineStyle}" />
                            <TextBlock x:Uid="ImportBody" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button x:Name="RecordSystemButton" x:Uid="RecordSystemButton" Grid.Column="1" Style="{StaticResource CardButtonStyle}"
                        Command="{x:Bind ViewModel.RecordSystemAudioCommand}" AccessKey="Y">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource IconWellStyle}" HorizontalAlignment="Left">
                            <FontIcon Glyph="{StaticResource FsIconRecordDevice}" FontSize="16" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="RecordSystemTitle" Style="{StaticResource HeadlineStyle}" />
                            <TextBlock x:Uid="RecordSystemBody" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Nothing heard, or something went wrong: said and shown, never silent. -->
            <InfoBar x:Uid="CaptureNotice" Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind vm:Screens.HasText(ViewModel.NoticeText), Mode=OneWay}"
                     Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}" />
            <InfoBar x:Uid="StartError" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind vm:Screens.HasText(ViewModel.ErrorText), Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />

            <!-- Your songs: the same list as the pane, as cards with the instrument, tuning and what is still to check. -->
            <TextBlock x:Uid="HomeSongsHeading" Style="{StaticResource OverlineStyle}" Margin="0,24,0,0"
                       AutomationProperties.HeadingLevel="Level2" Visibility="{x:Bind Main.LibraryView.HasItems, Mode=OneWay}" />
            <GridView x:Name="SongCards" x:Uid="SongCards" ItemsSource="{x:Bind Main.LibraryView.Items}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="OnSongCardClick" Visibility="{x:Bind Main.LibraryView.HasItems, Mode=OneWay}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItem">
                        <Border Style="{StaticResource CardStyle}" Width="264" Padding="16,14,8,14" AutomationProperties.Name="{x:Bind Title}"
                                AutomationProperties.HelpText="{x:Bind Subtitle}" ContextRequested="OnSongCardContextRequested">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="{StaticResource FsIconComputer}" FontSize="14" Foreground="{ThemeResource ScribeTextMutedBrush}"
                                                  Visibility="{x:Bind OnComputer}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource HeadlineStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top"
                                        Tag="{x:Bind}" Click="OnSongCardOptions" x:Uid="SongOptionsButton"
                                        AutomationProperties.HelpText="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Title}">
                                    <FontIcon Glyph="{StaticResource FsIconMore}" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <!-- Empty state: what will appear here. -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,24,0,0" Visibility="{x:Bind views:Shown.Not(Main.LibraryView.HasItems), Mode=OneWay}">
                <Image x:Name="EmptyMark" Width="28" Height="28" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Uid="HomeEmpty" Style="{StaticResource LeadStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kalli.Fretscribe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kalli.Scribe.ViewModels"
    xmlns:views="using:Kalli.Fretscribe.Views">

    <Grid x:Name="Root" Background="{ThemeResource ScribeBgBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <!-- Global shortcuts; all use a modifier. -->
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnImportAccelerator" />
            <KeyboardAccelerator Key="R" Modifiers="Control,Shift" Invoked="OnRecordAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: back, the page title, then Settings. The window's own caption buttons sit to the right
             (ExtendsContentIntoTitleBar). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="52" Padding="12,0,140,0" ColumnSpacing="12"
              Background="{ThemeResource ScribeBgBrush}" BorderBrush="{ThemeResource ScribeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" x:Uid="BackButton" Grid.Column="0" Style="{StaticResource PlainButtonStyle}" MinHeight="40"
                    Padding="10,6" Command="{x:Bind ViewModel.BackCommand}" AccessKey="B">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{StaticResource FsIconBack}" FontSize="14" />
                    <TextBlock x:Name="BackLabel" Style="{StaticResource LabelStyle}" />
                </StackPanel>
            </Button>
            <!-- The drag region is only the empty middle, so the buttons keep their clicks. -->
            <Border x:Name="DragRegion" Grid.Column="1" Grid.ColumnSpan="2" Background="Transparent" />
            <TextBlock x:Name="PageTitle" Grid.Column="1" Style="{StaticResource LabelStyle}" FontSize="15" VerticalAlignment="Center"
                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
            <Button x:Name="SettingsButton" x:Uid="SettingsButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                    Click="OnSettingsClick" AccessKey="S">
                <FontIcon Glyph="{StaticResource FsIconSettings}" FontSize="16" />
            </Button>
        </Grid>

        <!-- Your songs in the pane (on Home and while a tab is written), and the flow steps in a Frame. -->
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="280" CompactModeThresholdWidth="1008"
                        IsPaneVisible="{x:Bind views:Shown.Library(ViewModel.Screen), Mode=OneWay}"
                        MenuItemsSource="{x:Bind ViewModel.LibraryView.Items}" ItemInvoked="OnLibraryItemInvoked"
                        x:Uid="LibraryNav">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource ScribeSurfaceColor}" />
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource ScribeSurfaceColor}" />
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource ScribeBgColor}" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource ScribeSurfaceColor}" />
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource ScribeSurfaceColor}" />
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource ScribeBgColor}" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="ScribeSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="ScribeSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="ScribeBgBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <StackPanel Padding="12,16,12,4" Spacing="16">
                    <!-- Lockup: the mark and "Fretscribe". -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,0,0,0" AutomationProperties.Name="Fretscribe">
                        <Image x:Name="Mark" Width="22" Height="22" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Fretscribe" FontFamily="{StaticResource ScribeDisplayFontFamily}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource ScribeTextBrush}" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                    <Button x:Name="NewSongButton" x:Uid="NewSongButton" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Background="{ThemeResource ScribeSurfaceRaisedBrush}" BorderBrush="{ThemeResource ScribeBorderBrush}"
                            Command="{x:Bind ViewModel.NewSongCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="{StaticResource FsIconImportFile}" FontSize="16" />
                            <TextBlock x:Uid="NewSongLabel" Style="{StaticResource LabelStyle}" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Uid="LibraryHeading" Style="{StaticResource OverlineStyle}" Margin="12,8,0,0"
                               AutomationProperties.HeadingLevel="Level2" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:LibraryItem">
                    <NavigationViewItem MinHeight="60" AutomationProperties.Name="{x:Bind Title}" AutomationProperties.HelpText="{x:Bind Subtitle}"
                                        ToolTipService.ToolTip="{x:Bind Subtitle}" ContextRequested="OnLibraryItemContextRequested">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind vm:Screens.LibraryGlyph(OnComputer)}" />
                        </NavigationViewItem.Icon>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Padding="0,6">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedStyle}" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Padding="0"
                                    Tag="{x:Bind}" Click="OnLibraryItemOptions" x:Uid="SongOptionsButton"
                                    AutomationProperties.HelpText="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Title}">
                                <FontIcon Glyph="{StaticResource FsIconMore}" FontSize="14" />
                            </Button>
                        </Grid>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />
        </NavigationView>

        <!-- Something failed that the app carries on from (see MainWindow.ShowProblem). -->
        <InfoBar x:Name="ProblemBar" Grid.Row="1" Severity="Warning" IsOpen="False" IsClosable="True"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="640" Margin="16" />
    </Grid>
</Window>

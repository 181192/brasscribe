<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Kalli.Fretscribe.Dialogs.ExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tab="using:Kalli.Scribe.Tab"
    xmlns:views="using:Kalli.Fretscribe.Views"
    x:Uid="ExportDialog"
    DefaultButton="Close">
    <!-- Share or print: the PDF to print or keep, the MusicXML, MIDI, the tab as text and the playing instructions.
         One that can't be had now stays in the list, dimmed, and says why. -->
    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MinWidth="440">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Options}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="tab:TabExportOption">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{x:Bind HelpText, Mode=OneWay}" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" MinHeight="40" VerticalAlignment="Center"
                                    Click="OnSave" Tag="{x:Bind}" IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind SaveName}" AutomationProperties.HelpText="{x:Bind HelpText, Mode=OneWay}">
                                <TextBlock x:Uid="ExportSaveLabel" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" Visibility="{x:Bind views:Shown.HasText(ViewModel.StatusText), Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Kalli.Fretscribe.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:engine="using:Kalli.Scribe.Engine"
    xmlns:views="using:Kalli.Fretscribe.Views"
    x:Uid="SettingsDialog"
    DefaultButton="Close">
    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MinWidth="420">
            <!-- Your instrument: the first section. The row shows the answer; Change opens Your instrument, and nothing
                 changes until Save there. -->
            <TextBlock x:Uid="SettingsYouHeading" Style="{StaticResource SectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="InstrumentRowLabel" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="InstrumentValue" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="InstrumentChangeButton" x:Uid="InstrumentChangeButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}"
                        MinHeight="44" VerticalAlignment="Center" Click="OnChangeInstrument" />
            </Grid>

            <TextBlock x:Uid="SettingsLanguageHeading" Style="{StaticResource SectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
            <ComboBox x:Name="LanguageBox" x:Uid="LanguageBox" SelectionChanged="OnLanguageChanged" HorizontalAlignment="Stretch">
                <ComboBoxItem x:Uid="LanguageSystem" Tag="system" />
                <ComboBoxItem Content="English" Tag="en-US" />
                <ComboBoxItem Content="Norsk bokmål" Tag="nb-NO" />
            </ComboBox>
            <TextBlock x:Uid="LanguageRestartNote" Style="{StaticResource MutedStyle}" />

            <TextBlock x:Uid="SettingsAccessibilityHeading" Style="{StaticResource SectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
            <!-- Appearance: one native choice, applied at once, stored on this PC. A contrast theme always wins; the box
                 stays enabled and the line below says why. -->
            <ComboBox x:Name="AppearanceBox" x:Uid="AppearanceBox" SelectionChanged="OnAppearanceChanged" HorizontalAlignment="Stretch">
                <ComboBoxItem x:Uid="AppearanceSystem" />
                <ComboBoxItem x:Uid="AppearanceLight" />
                <ComboBoxItem x:Uid="AppearanceDark" />
            </ComboBox>
            <TextBlock x:Uid="AppearanceContrastNote" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HighContrast, Mode=OneWay}" />
            <ToggleSwitch x:Uid="ReduceMotionSwitch" IsOn="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}" />

            <TextBlock x:Uid="SettingsEngineHeading" Style="{StaticResource SectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
            <!-- The same status row as Home. -->
            <views:ConnectionRow x:Name="ConnectionStatus" ActionInvoked="OnConnectionAction" />
            <Button x:Uid="FindEnginesButton" Click="OnFindEngines" />
            <ListView x:Uid="DiscoveredEnginesList" ItemsSource="{x:Bind ViewModel.DiscoveredEngines}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="OnEngineClicked">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="engine:DiscoveredEngine">
                        <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind ComputerName}">
                            <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Bind ComputerName}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBox x:Name="PairingCodeBox" x:Uid="PairingCodeBox" Text="{x:Bind ViewModel.PairingCode, Mode=TwoWay}" InputScope="Number" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="ConnectButton" Style="{StaticResource ActionButtonStyle}" MinHeight="44" Click="OnConnect" />
                <Button x:Uid="AskComputerButton" Style="{StaticResource ActionButtonStyle}" MinHeight="44" Click="OnAskComputer"
                        Visibility="{x:Bind views:Shown.Not(ViewModel.IsAsking), Mode=OneWay}" />
            </StackPanel>
            <!-- Approve on the computer: the match code large, read digit by digit; no countdown. -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsAsking, Mode=OneWay}">
                <TextBlock x:Uid="MatchCodeLabel" Style="{StaticResource MutedStyle}" />
                <TextBlock Style="{StaticResource NumericStyle}" FontSize="40" Text="{x:Bind ViewModel.MatchCode, Mode=OneWay}"
                           AutomationProperties.Name="{x:Bind ViewModel.MatchCodeSpoken, Mode=OneWay}" IsTextSelectionEnabled="True" />
                <Button x:Uid="CancelAskButton" Style="{StaticResource ActionButtonStyle}" MinHeight="44" Click="OnCancelAsk" />
            </StackPanel>
            <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <!-- Where the update is, when connecting or pairing stopped because one of the two must be updated. -->
            <HyperlinkButton x:Name="EngineUpdateLink" Padding="6,4" Margin="-6,0,0,0" MinHeight="44"
                             NavigateUri="{x:Bind ViewModel.EngineStatusLink, Mode=OneWay}"
                             Content="{x:Bind ViewModel.EngineStatusLinkLabel}"
                             AutomationProperties.HelpText="{x:Bind ViewModel.EngineStatusLinkHelp}"
                             Visibility="{x:Bind ViewModel.HasEngineStatusLink, Mode=OneWay}" />
            <Button x:Uid="UnpairButton" Style="{StaticResource ActionButtonStyle}" MinHeight="44" Click="OnUnpair"
                    Visibility="{x:Bind ViewModel.IsPaired, Mode=OneWay}" />
            <!-- Addresses, the server id and when it last answered: for whoever set the computer up. -->
            <Expander x:Uid="EngineDetails" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBox x:Uid="EngineAddressBox" Text="{x:Bind ViewModel.EngineAddress, Mode=TwoWay}" InputScope="Url" />
                    <TextBlock Style="{StaticResource MutedStyle}" Text="{x:Bind ViewModel.Connection.DetailsText, Mode=OneWay}"
                               IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <TextBlock x:Uid="SettingsAboutHeading" Style="{StaticResource SectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Uid="AboutText" Style="{StaticResource MutedStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            <TextBlock x:Name="AppVersion" Style="{StaticResource MutedStyle}" IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

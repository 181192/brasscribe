<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Kalli.Brasscribe.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kalli.Scribe.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Generated from design/tooling (linked from design/brands/brasscribe/dist/windows): colours per theme, contrast
                     themes on system colours, spacing, radii, type ramp and icon glyphs. -->
                <ResourceDictionary Source="ms-appx:///Themes/BrasscribeTheme.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <controls:IntToDoubleConverter x:Key="IntToDouble" />
            <controls:PathDataConverter x:Key="PathData" />
            <controls:NotConverter x:Key="NotVisible" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

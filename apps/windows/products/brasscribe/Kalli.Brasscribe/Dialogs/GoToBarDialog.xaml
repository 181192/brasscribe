<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Brasscribe.Play.Dialogs.GoToBarDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="GoToBarDialog"
    DefaultButton="Primary">
    <!-- Typing here never triggers score shortcuts (WCAG 2.1.4): the score keys only work in the score view. -->
    <NumberBox x:Name="BarBox" x:Uid="GoToBarBox" Minimum="1" SpinButtonPlacementMode="Inline"
               ValidationMode="InvalidInputOverwritten" />
</ContentDialog>

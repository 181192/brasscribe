<Project>
  <PropertyGroup>
    <!-- Pinned to the last ONNX Runtime release with a DirectML build: the managed API must match the native binary. -->
    <OnnxRuntimeVersion>1.24.4</OnnxRuntimeVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="AlphaTab" Version="1.8.4" />
    <PackageVersion Include="AlphaSkia" Version="3.4.135" />
    <PackageVersion Include="AlphaSkia.Native.Windows" Version="3.4.135" />
    <PackageVersion Include="AlphaSkia.Native.MacOs" Version="3.5.147" />
    <PackageVersion Include="AlphaSkia.Native.Linux" Version="3.5.147" />
    <PackageVersion Include="NAudio.Core" Version="2.2.1" />
    <PackageVersion Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="$(OnnxRuntimeVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="$(OnnxRuntimeVersion)" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Axe.Windows" Version="2.4.2" />
    <!-- The screen catalogue (tests/Brasscribe.Play.Catalogue) and its out-of-process checks (tools/ScreenCheck). -->
    <PackageVersion Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>
</Project>

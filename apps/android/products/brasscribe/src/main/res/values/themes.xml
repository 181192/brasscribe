<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: Brasscribe's token bg (design/tokens/tokens.json) in light and dark,
         and of the hidden Pink palette. Not night-qualified: the app's own Appearance setting
         picks one (MainActivity), whatever the phone's night mode is. -->
    <color name="window_light">#FFFBFAF7</color>
    <color name="window_dark">#FF131210</color>
    <color name="window_pink">#FFFFF6F9</color>
    <color name="window_pink_dark">#FF1B1017</color>
    <!-- With the phone's high contrast on: the bg of the high-contrast palettes. -->
    <color name="window_contrast_light">#FFFFFFFF</color>
    <color name="window_contrast_dark">#FF000000</color>
    <!-- Window theme only; the UI is Compose Material 3 (features/play, ui/theme). -->
    <style name="Theme.Play" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
    </style>
</resources>

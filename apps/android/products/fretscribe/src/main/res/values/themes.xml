<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: Fretscribe's token bg (design/fretscribe/tokens/tokens.json) in light and dark,
         and the same again for Pink, which Fretscribe does not have. Not night-qualified: the app's own Appearance setting
         picks one (MainActivity), whatever the phone's night mode is. -->
    <color name="window_light">#FFFAF8F3</color>
    <color name="window_dark">#FF15171A</color>
    <color name="window_pink">#FFFAF8F3</color>
    <color name="window_pink_dark">#FF15171A</color>
    <!-- With the phone's high contrast on: the bg of the high-contrast palettes. -->
    <color name="window_contrast_light">#FFFFFFFF</color>
    <color name="window_contrast_dark">#FF000000</color>
    <!-- Window theme only; the UI is Compose Material 3 (features/play, ui/theme). -->
    <style name="Theme.Play" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
    </style>
</resources>

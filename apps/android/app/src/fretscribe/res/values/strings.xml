    <!-- Help (Settings > Help): what this app does, in its own words. -->
    <string name="help_1_title">Write down a tab</string>
    <string name="help_1_text">Open a recording, or record with the microphone. Say what it is, and Fretscribe on your computer writes down the notes as tab for your instrument.</string>
    <string name="help_2_text">A “?” above a note means Fretscribe wasn\'t sure of it. A boxed “!” marks a note your instrument can\'t play there. Listen to that bar of the recording to check it.</string>
    <string name="help_3_text">Slow the recording down, and repeat the hard bars.</string>
    <string name="help_4_title">Your songs</string>
    <string name="help_4_text">Every tab you make is kept under Your songs, on the phone and on your computer.</string>
    <string name="help_5_title">Tabs are written on your computer</string>
    <string name="help_5_text">Fretscribe on your computer writes down the notes. Open it there, and connect in Settings.</string>
    <!-- The keys while a tab plays: Fretscribe has no music stand. -->
    <string name="help_stand_title">Page turners and keys</string>


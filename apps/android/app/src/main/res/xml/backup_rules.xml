<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="file" path="takes" />
    <!-- Paired-computer credentials: encrypted with a Keystore key that a backup cannot carry. -->
    <exclude domain="sharedpref" path="credentials.xml" />
    <!-- Per phone: Settings › Display › Appearance (design/system.md §10) and Settings › Your instrument. -->
    <exclude domain="sharedpref" path="device.xml" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The companion engine runs on the user's own computer on the local network and serves plain HTTP
  (pairing code plus bearer token). Cleartext is allowed for that; everything else stays HTTPS-only.
  Android's domain matching cannot express "any private address", so cleartext is on in the base
  config and the app itself only ever connects to the address the user types in.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

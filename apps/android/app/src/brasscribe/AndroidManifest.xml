<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- ONNX Runtime's AAR adds this provider so that the runtime can report to Microsoft: before the
             app starts it reads the device's ANDROID_ID, maker and model and follows the network and the
             battery. Nothing leaves the phone but what goes to the player's own computer, so it is taken
             out. The app also turns the runtime's telemetry off when it starts (OnPhoneModels), and
             verifyNoTelemetry<Variant> fails the build if the provider is back in the merged manifest.
             Fretscribe has no ONNX Runtime, so the line is Brasscribe's. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
    </application>
</manifest>

      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigjør plass …"
          }
        }
      }
    },
    "Full-band scores need one more step": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Partitur for fullt band trenger ett steg til"
          }
        }
      }
    },
    "Get an access key on Hugging Face": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent en tilgangsnøkkel hos Hugging Face"
          }
        }
      }
    },
    "Getting full": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynner å bli fullt"
          }
        }
      }
    },
    "Getting the recording ready": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør opptaket klart"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": " punktum "
          }
        }
      }
    },
    "%@ is paired.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er koblet til."
          }
        }
      }
    },
    "%@ keeps the recording and can send it again.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beholder opptaket og kan sende det på nytt."
          }
        }
      }
    },
    "%@ wants to use this computer.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vil bruke denne datamaskinen."
          }
        }
      }
    },
    "%@: %@ · %@ · paired %@": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ · %@ · sammenkoblet %@"

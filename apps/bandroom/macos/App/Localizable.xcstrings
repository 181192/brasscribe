      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Datamappe"
          }
        }
      }
    },
    "Details for the band's tech person": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Detaljer for den tekniske i bandet"
          }
        }
      }
    },
    "Do this once for each phone or tablet. It stays paired.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør dette én gang per telefon eller nettbrett. Den forblir tilkoblet."
          }
        }
      }
    },
    "Don't allow": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke godkjenn"
          }
        }
      }
    },
    "Don't see it? On a MacBook it can hide behind the camera notch. Open Brasscribe from Launchpad any time.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser du det ikke? På en MacBook kan det skjule seg bak kamerahakket. Du kan alltid åpne Brasscribe fra Launchpad."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferdig"
          }
        }
      }
    },

      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett uten"
          }
        }
      }
    },
    "Copy details for the tech person": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier detaljer til den tekniske i bandet"

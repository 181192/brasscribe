      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgang til Hugging Face"
          }
        }
      }
    },
    "Instrument separator": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumentskiller"
          }
        }
      }
    },
    "Internet: needed once, for the downloads": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Internett: trengs én gang, til nedlastingene"
          }
        }
      }
    },
    "It can send recordings to this computer and get scores back. You can remove it any time.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan sende opptak til denne datamaskinen og få partitur tilbake. Du kan fjerne den når som helst."
          }
        }
      }
    },
    "It can't send recordings here until it is paired again. Scores already on it stay.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan ikke sende opptak hit før den kobles til igjen. Partitur som allerede ligger på den, blir liggende."
          }
        }
      }
    },
    "It runs quietly in the menu bar. Look for the Brasscribe mark at the top of the screen.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kjører i det stille i menylinjen. Se etter Brasscribe-merket øverst på skjermen."
          }
        }
      }
    },
    "It tried to start three times. Recordings on your phones are safe.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den prøvde å starte tre ganger. Opptakene på telefonene er trygge."
          }
        }
      }
    },
    "Keep going": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett"
          }
        }
      }
    },
    "Large": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stor"
          }
        }
      }
    },
    "Larger": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Større"
          }
        }
      }
    },

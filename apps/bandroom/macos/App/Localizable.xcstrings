    "Finding the beat": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finner pulsen"
          }
        }
      }
    },
    "Finish setting up": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør ferdig oppsettet"
          }
        }
      }
    },
    "For when the Brasscribe mark is hidden in the menu bar, for example behind the camera notch.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Til når Brasscribe-merket er skjult i menylinjen, for eksempel bak kamerahakket."
          }
        }
      }
    },

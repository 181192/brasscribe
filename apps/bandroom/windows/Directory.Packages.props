<Project>
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <!-- The Windows App SDK's parts the apps use, not its Microsoft.WindowsAppSDK package, which also brings the
         Windows ML runtime, Windows AI, Search and
         Widgets, none of which the apps use. One version for all parts. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.Base" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Axe.Windows" Version="2.4.2" />
  </ItemGroup>
</Project>

<Project>
  <PropertyGroup>
    <!-- The app version, bumped with the others by scripts/release.sh. -->
    <Version>0.6.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>brasscribe</Authors>
    <Product>Brasscribe Bandroom</Product>
    <Company>brasscribe</Company>
    <Copyright>Copyright (c) 2026 Kristoffer-Andre Kalliainen</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <!-- Lets the Windows-only projects compile against reference assemblies on macOS and Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <BrasscribeWindowsTfm>net10.0-windows10.0.20348.0</BrasscribeWindowsTfm>
    <BrasscribeWindowsMinVersion>10.0.19041.0</BrasscribeWindowsMinVersion>
    <!-- The repository root: design/ (theme, icons, the mark) and the pixi workspace are linked from there, never copied. -->
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <DesignDir>$(RepoRoot)design\</DesignDir>
  </PropertyGroup>
</Project>

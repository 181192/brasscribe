{
  "$description": "The neutral part of the design system: what every brand's generated theme has, under the same names (Scribe*), so shared code compiles against any brand. It is kept small: surfaces, text, edges, the two button fills, the brand colour, status, focus, ink, the ruled line and doubt, with the type ramp, spacing, radii, sizes and motion. Everything else is a brand's own and stays in that brand's own type. A brand whose token has another name maps it under $extensions.<brand>.neutral.roles (neutral name, then the brand's token). windows and web name the system colour a role takes in a Windows contrast theme and under forced-colors.",
  "modes": ["light", "dark", "high-contrast", "high-contrast-light"],
  "roles": {
    "bg": {"windows": "SystemColorWindowColor", "web": "Canvas"},
    "surface": {"windows": "SystemColorWindowColor", "web": "Canvas"},
    "surface-raised": {"windows": "SystemColorWindowColor", "web": "Canvas"},
    "text": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "text-muted": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "border": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "border-strong": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "primary": {"windows": "SystemColorHighlightColor", "web": "Highlight"},
    "on-primary": {"windows": "SystemColorHighlightTextColor", "web": "HighlightText"},
    "secondary": {"windows": "SystemColorButtonFaceColor", "web": "ButtonFace"},
    "on-secondary": {"windows": "SystemColorButtonTextColor", "web": "ButtonText"},
    "brand": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "brand-text": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "brand-tint": {"windows": "SystemColorWindowColor", "web": "Canvas"},
    "success": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "warning": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "error": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "focus": {"windows": "SystemColorHighlightColor", "web": "Highlight"},
    "scrim": {"windows": "SystemColorWindowColor", "web": "Canvas"},
    "ink": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "line": {"windows": "SystemColorWindowTextColor", "web": "CanvasText"},
    "uncertain": {"windows": "SystemColorHotlightColor", "web": "LinkText"}
  }
}
